@model List<OmniBizAI.ViewModels.ApprovalStepItem>
@* Partial: Approval Timeline Stepper (F6.6) *@

@if (Model != null && Model.Any())
{
    <div class="approval-timeline-section" style="margin-top: 20px;">
        <h6 style="font-weight: 700; font-size: .88rem; margin-bottom: 14px; display: flex; align-items: center; gap: 6px;">
            <i class="fa-solid fa-diagram-next" style="color: var(--apple-blue)"></i> Tiến trình phê duyệt
        </h6>
        <div class="approval-stepper">
            @foreach (var step in Model)
            {
                var isApproved = step.Status == "Approved";
                var isRejected = step.Status == "Rejected";
                var isPending = step.Status == "Pending";
                var isSkipped = step.Status == "Skipped";
                var dotColor = isApproved ? "var(--success)" : isRejected ? "var(--danger)" : isPending ? "#ff9500" : "#8e8e93";
                var lineColor = isApproved ? "var(--success)" : "var(--divider)";
                var icon = isApproved ? "fa-check" : isRejected ? "fa-xmark" : isPending ? "fa-hourglass-half" : "fa-rotate-left";

                <div class="stepper-step @(step.IsCurrent ? "stepper-current" : "")">
                    <div class="stepper-dot" style="background: @dotColor; color: white;">
                        <i class="fa-solid @icon" style="font-size: .55rem;"></i>
                    </div>
                    <div class="stepper-content">
                        <div class="stepper-title">@step.StepName</div>
                        <div class="stepper-meta">
                            @if (step.AssignedToName != null)
                            {
                                <span><i class="fa-solid fa-user" style="font-size:.6rem"></i> @step.AssignedToName</span>
                            }
                            else if (step.AssignedRole != null)
                            {
                                <span><i class="fa-solid fa-users" style="font-size:.6rem"></i> @step.AssignedRole</span>
                            }
                            @if (step.DecidedAt.HasValue)
                            {
                                <span><i class="fa-solid fa-clock" style="font-size:.6rem"></i> @step.DecidedAt.Value.ToLocalTime().ToString("dd/MM HH:mm")</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(step.DecisionNote))
                        {
                            <div class="stepper-note">@step.DecisionNote</div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <style>
        .approval-stepper { display: flex; flex-direction: column; gap: 0; padding-left: 4px; }
        .stepper-step { display: flex; gap: 12px; position: relative; padding-bottom: 16px; }
        .stepper-step:not(:last-child)::after {
            content: ''; position: absolute; left: 11px; top: 26px; bottom: 0;
            width: 2px; background: var(--divider);
        }
        .stepper-step.stepper-current { animation: pulse-glow 2s infinite; }
        .stepper-dot {
            width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
            flex-shrink: 0; z-index: 1;
        }
        .stepper-content { flex: 1; min-width: 0; }
        .stepper-title { font-weight: 600; font-size: .82rem; }
        .stepper-meta { display: flex; gap: 10px; font-size: .7rem; color: var(--text-muted); margin-top: 2px; flex-wrap: wrap; }
        .stepper-note { font-size: .72rem; color: var(--text-secondary); margin-top: 4px; font-style: italic; padding: 4px 8px; background: var(--hover-bg); border-radius: 6px; }
        @@keyframes pulse-glow { 0%,100% { opacity: 1; } 50% { opacity: .7; } }
    </style>
}
