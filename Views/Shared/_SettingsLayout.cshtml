@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<style>
    /* Premium overrides for Settings Layout */
    .settings-ide-container {
        background: var(--canvas);
        border: 1px solid var(--divider);
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
        display: flex;
        flex-direction: column;
        height: calc(100vh - var(--topbar-h) - 100px);
        min-height: 600px;
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        backdrop-filter: blur(20px);
    }

    .settings-ide-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 20px 28px;
        border-bottom: 1px solid var(--divider);
        background: linear-gradient(180deg, var(--parchment), var(--canvas));
    }

    .settings-title {
        font-size: 1.35rem;
        font-weight: 700;
        margin: 0;
        letter-spacing: -0.02em;
        background: linear-gradient(135deg, var(--text-primary), var(--apple-blue));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .settings-subtitle {
        font-size: 0.72rem;
        font-weight: 500;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .settings-ide-search-bar {
        width: 320px;
    }

    .settings-ide-search-bar .input-group {
        border-radius: 10px;
        background: var(--parchment);
        border: 1px solid var(--hairline);
        transition: all 0.2s ease;
        padding: 2px;
    }

    .settings-ide-search-bar .input-group:focus-within {
        border-color: var(--apple-blue);
        box-shadow: 0 0 0 3px rgba(0, 113, 227, 0.12);
        background: var(--canvas);
    }

    .settings-ide-search-bar input {
        border: none !important;
        background: transparent !important;
        font-size: 0.8rem !important;
        color: var(--text-primary) !important;
        padding-left: 8px !important;
    }

    .settings-ide-search-bar input:focus {
        box-shadow: none !important;
    }

    .search-kbd-hint {
        display: flex;
        align-items: center;
        gap: 2px;
        padding: 2px 6px;
        background: var(--canvas);
        border: 1px solid var(--divider);
        border-radius: 6px;
        font-size: 0.65rem;
        color: var(--text-muted);
        font-weight: 600;
        margin-right: 6px;
        user-select: none;
    }

    .settings-ide-subtabs {
        display: flex;
        border-bottom: 1px solid var(--divider);
        background: var(--parchment);
        padding: 0 28px;
        height: 42px;
        align-items: flex-end;
    }

    .settings-subtab {
        padding: 10px 20px;
        font-size: 0.82rem;
        cursor: pointer;
        color: var(--text-muted);
        position: relative;
        margin-right: 12px;
        transition: all 0.2s ease;
        font-weight: 550;
        text-decoration: none !important;
        border-radius: 8px 8px 0 0;
    }

    .settings-subtab:hover {
        color: var(--text-primary);
        background: rgba(0, 113, 227, 0.03);
    }

    .settings-subtab.active {
        color: var(--apple-blue) !important;
        font-weight: 600;
        background: var(--canvas);
        border: 1px solid var(--divider);
        border-bottom: 1px solid var(--canvas);
    }

    .settings-ide-body {
        display: flex;
        flex: 1;
        overflow: hidden;
    }

    .settings-ide-sidebar {
        width: 260px;
        border-right: 1px solid var(--divider);
        background: var(--parchment);
        padding: 20px 12px;
        display: flex;
        flex-direction: column;
        overflow-y: auto;
        gap: 16px;
    }

    .settings-nav-group-header {
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        color: var(--text-muted);
        padding: 8px 12px;
        display: flex;
        align-items: center;
        gap: 8px;
        text-transform: uppercase;
        cursor: pointer;
        user-select: none;
        transition: color 0.2s ease;
    }

    .settings-nav-group-header:hover {
        color: var(--text-primary);
    }

    .settings-nav-group-header i {
        transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        font-size: 0.7rem;
    }

    .settings-nav-group.collapsed .settings-nav-group-header i {
        transform: rotate(-90deg);
    }

    .settings-nav-items {
        display: flex;
        flex-direction: column;
        gap: 4px;
        margin-top: 4px;
        transition: max-height 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        overflow: hidden;
    }

    .settings-nav-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 9px 14px;
        font-size: 0.82rem;
        color: var(--text-secondary);
        border-radius: 8px;
        border-left: 3px solid transparent;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        text-decoration: none !important;
        font-weight: 500;
    }

    .settings-nav-item i {
        width: 18px;
        text-align: center;
        font-size: 0.95rem;
        opacity: 0.75;
        transition: transform 0.2s ease;
    }

    .settings-nav-item:hover {
        background: var(--divider);
        color: var(--text-primary);
        padding-left: 16px;
    }

    .settings-nav-item:hover i {
        transform: scale(1.1);
        opacity: 1;
    }

    .settings-nav-item.active {
        background: rgba(0, 113, 227, 0.07) !important;
        color: var(--apple-blue) !important;
        border-left-color: var(--apple-blue);
        font-weight: 600;
    }

    .settings-nav-item.active i {
        opacity: 1;
        color: var(--apple-blue);
        transform: scale(1.05);
    }

    .settings-ide-content {
        flex: 1;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        background: var(--canvas);
    }

    .settings-ide-content-scroll {
        flex: 1;
        overflow-y: auto;
        padding: 28px;
    }

    /* System Status Card in Sidebar */
    .settings-status-card {
        margin-top: auto;
        padding: 14px;
        border-radius: 12px;
        background: linear-gradient(135deg, rgba(0, 113, 227, 0.04), rgba(0, 113, 227, 0.01));
        border: 1px solid var(--divider);
        display: flex;
        flex-direction: column;
        gap: 6px;
        animation: fadeIn 0.4s ease;
    }

    /* Soft blink animations for active dot */
    .pulse-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background-color: var(--success, #34c759);
        display: inline-block;
        box-shadow: 0 0 0 0 rgba(52, 199, 89, 0.4);
        animation: pulseDot 2s infinite;
    }

    @@keyframes pulseDot {
        0% {
            transform: scale(0.95);
            box-shadow: 0 0 0 0 rgba(52, 199, 89, 0.5);
        }
        70% {
            transform: scale(1);
            box-shadow: 0 0 0 5px rgba(52, 199, 89, 0);
        }
        100% {
            transform: scale(0.95);
            box-shadow: 0 0 0 0 rgba(52, 199, 89, 0);
        }
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(4px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Responsive details */
    @@media(max-width: 767.98px) {
        .settings-ide-container {
            height: auto;
            min-height: 0;
            overflow: visible;
        }
        .settings-ide-body {
            flex-direction: column;
            overflow: visible;
        }
        .settings-ide-sidebar {
            width: 100%;
            border-right: none;
            border-bottom: 1px solid var(--divider);
            overflow: visible;
            padding: 16px;
        }
        .settings-ide-content {
            overflow: visible;
        }
        .settings-status-card {
            margin-top: 16px;
        }
        .settings-ide-search-bar {
            width: 100%;
            margin-top: 12px;
        }
        .settings-ide-header {
            flex-direction: column;
            align-items: flex-start;
            padding: 16px;
        }
    }
</style>

<div class="settings-ide-container fade-in">
    <!-- Header of Settings Page -->
    <div class="settings-ide-header">
        <div class="settings-ide-title-bar">
            <h3 class="settings-title">Cài đặt</h3>
            <span class="settings-subtitle">Cấu hình hệ thống OmniBizAI</span>
        </div>
        <div class="settings-ide-search-bar">
            <div class="input-group">
                <span class="input-group-text bg-transparent border-0 text-muted pe-1"><i class="fa-solid fa-magnifying-glass"></i></span>
                <input type="text" id="settingsSearch" class="form-control" placeholder="Tìm kiếm thiết lập..." onkeyup="filterSettings()" />
                <span class="search-kbd-hint">⌘K</span>
            </div>
        </div>
    </div>

    <!-- VS Code Style Subtabs -->
    <div class="settings-ide-subtabs">
        <a href="@Url.Action("Company", "Settings")" class="settings-subtab @(currentController == "Settings" ? "active" : "")">Thiết lập hệ thống</a>
        <a href="@Url.Action("Index", "Backup")" class="settings-subtab @(currentController == "Backup" || currentController == "Audit" ? "active" : "")">Quản trị & Nhật ký</a>
    </div>

    <!-- Main settings area -->
    <div class="settings-ide-body">
        <!-- Left Categories Sidebar -->
        <aside class="settings-ide-sidebar">
            <div class="settings-nav-group" id="sysGroup">
                <div class="settings-nav-group-header" onclick="toggleNavGroup('sysGroup')">
                    <i class="fa-solid fa-chevron-down me-1"></i> <span>HỆ THỐNG</span>
                </div>
                <div class="settings-nav-items">
                    <a href="@Url.Action("Company", "Settings")" class="settings-nav-item @(currentController == "Settings" && currentAction == "Company" ? "active" : "")" data-keywords="công ty doanh nghiệp tenant thong tin">
                        <i class="fa-solid fa-building-columns"></i> <span>Cài đặt công ty</span>
                    </a>
                    <a href="@Url.Action("Modules", "Settings")" class="settings-nav-item @(currentController == "Settings" && currentAction == "Modules" ? "active" : "")" data-keywords="modules tinh nang bat tat chuc nang">
                        <i class="fa-solid fa-puzzle-piece"></i> <span>Quản lý modules</span>
                    </a>
                    <a href="@Url.Action("Parameters", "Settings")" class="settings-nav-item @(currentController == "Settings" && currentAction == "Parameters" ? "active" : "")" data-keywords="tham so he thong cau hinh config">
                        <i class="fa-solid fa-sliders"></i> <span>Tham số hệ thống</span>
                    </a>
                    <a href="@Url.Action("EnumLabels", "Settings")" class="settings-nav-item @(currentController == "Settings" && currentAction == "EnumLabels" ? "active" : "")" data-keywords="nhan he thong tags danh muc enum label">
                        <i class="fa-solid fa-tags"></i> <span>Nhãn hệ thống</span>
                    </a>
                    <a href="@Url.Action("Appearance", "Settings")" class="settings-nav-item @(currentController == "Settings" && currentAction == "Appearance" ? "active" : "")" data-keywords="giao dien mau sac theme dark mode light font size border radius font logo icon">
                        <i class="fa-solid fa-palette"></i> <span>Giao diện</span>
                    </a>
                </div>
            </div>

            <div class="settings-nav-group" id="adminGroup">
                <div class="settings-nav-group-header" onclick="toggleNavGroup('adminGroup')">
                    <i class="fa-solid fa-chevron-down me-1"></i> <span>QUẢN TRỊ</span>
                </div>
                <div class="settings-nav-items">
                    <a href="@Url.Action("Index", "Backup")" class="settings-nav-item @(currentController == "Backup" ? "active" : "")" data-keywords="sao luu khoi phuc database backup restore sql server json data">
                        <i class="fa-solid fa-database"></i> <span>Sao lưu dữ liệu</span>
                    </a>
                    <a href="@Url.Action("Index", "Audit")" class="settings-nav-item @(currentController == "Audit" ? "active" : "")" data-keywords="nhat ky audit log he thong lich su hoat dong security">
                        <i class="fa-solid fa-shield-halved"></i> <span>Nhật ký hệ thống</span>
                    </a>
                </div>
            </div>

            <!-- Status Card -->
            <div class="settings-status-card">
                <div class="d-flex align-items-center justify-content-between">
                    <span style="font-size: .75rem; font-weight: 600; color: var(--text-primary);"><i class="fa-solid fa-circle-check text-success me-1"></i> Hệ thống</span>
                    <span class="status-badge-soft badge-on-track" style="font-size: .62rem; padding: 2px 6px; font-weight: 600; border: none; display: flex; align-items: center; gap: 4px;">
                        <span class="pulse-dot"></span>Hoạt động
                    </span>
                </div>
                <div class="d-flex justify-content-between text-muted" style="font-size: 0.68rem;">
                    <span>Phiên bản</span>
                    <span class="fw-semibold" style="color: var(--text-secondary)">v2.6.0-stable</span>
                </div>
            </div>
        </aside>

        <!-- Right Content Pane -->
        <main class="settings-ide-content">
            <div class="settings-ide-content-scroll">
                @RenderBody()
            </div>
        </main>
    </div>
</div>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        function toggleNavGroup(groupId) {
            var group = document.getElementById(groupId);
            if (group) {
                group.classList.toggle('collapsed');
            }
        }

        function filterSettings() {
            var input = document.getElementById("settingsSearch");
            var filter = input.value.toLowerCase().trim();
            var items = document.querySelectorAll(".settings-nav-item");
            
            items.forEach(function(item) {
                var text = item.textContent.toLowerCase();
                var keywords = item.getAttribute("data-keywords") || "";
                if (text.indexOf(filter) > -1 || keywords.toLowerCase().indexOf(filter) > -1) {
                    item.style.display = "";
                } else {
                    item.style.display = "none";
                }
            });
        }

        // Focus search box with Cmd+K or Ctrl+K shortcut
        document.addEventListener('keydown', function(e) {
            if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
                e.preventDefault();
                document.getElementById("settingsSearch")?.focus();
            }
        });
    </script>
}
