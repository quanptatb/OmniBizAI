@model List<OmniBizAI.ViewModels.FailureModeItem>
@using OmniBizAI.Models.Entities.Enums
@{
    ViewData["Title"] = "Failure Modes — Phân loại lỗi";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var search = ViewBag.Search as string;
    var categoryFilter = ViewBag.CategoryFilter as FailureModeCategory?;
    var activeOnly = ViewBag.ActiveOnly as bool?;
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0 text-gray-800">
            <i class="fas fa-exclamation-triangle me-2 text-warning"></i>Failure Modes
        </h1>
        <p class="text-muted small mb-0">Quản lý danh mục phân loại lỗi & hỏng hóc thiết bị</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Statistics" class="btn btn-outline-info shadow-sm">
            <i class="fas fa-chart-bar me-1"></i>Thống kê
        </a>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="fas fa-plus me-1"></i>Thêm mới
        </a>
    </div>
</div>

<!-- Filters -->
<div class="card shadow-sm mb-4">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <input type="text" name="search" value="@search" class="form-control form-control-sm" placeholder="Tìm theo mã, tên...">
            </div>
            <div class="col-md-3">
                <select name="category" class="form-select form-select-sm">
                    <option value="">— Tất cả nhóm —</option>
                    @foreach (var cat in Enum.GetValues<FailureModeCategory>())
                    {
                        <option value="@cat" selected="@(categoryFilter == cat)">@cat</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <div class="form-check">
                    <input type="checkbox" name="activeOnly" value="true" class="form-check-input" id="activeOnlyChk"
                           checked="@(activeOnly == true)">
                    <label class="form-check-label small" for="activeOnlyChk">Chỉ Active</label>
                </div>
            </div>
            <div class="col-md-3 text-end">
                <button type="submit" class="btn btn-sm btn-outline-primary"><i class="fas fa-filter me-1"></i>Lọc</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary ms-1">Xóa bộ lọc</a>
            </div>
        </form>
    </div>
</div>

<!-- Table -->
<div class="card shadow">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:100px">Mã</th>
                        <th>Tên</th>
                        <th style="width:130px">Nhóm</th>
                        <th>Biện pháp phòng ngừa</th>
                        <th class="text-center" style="width:90px">Incidents</th>
                        <th class="text-center" style="width:80px">Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                <i class="fas fa-inbox fa-2x mb-2 d-block text-gray-300"></i>
                                Chưa có failure mode nào.
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        var catBadge = item.Category switch
                        {
                            FailureModeCategory.Mechanical => "bg-primary",
                            FailureModeCategory.Electrical => "bg-warning text-dark",
                            FailureModeCategory.Hydraulic => "bg-info",
                            FailureModeCategory.Pneumatic => "bg-secondary",
                            FailureModeCategory.Software => "bg-dark",
                            FailureModeCategory.Human => "bg-danger",
                            FailureModeCategory.Environmental => "bg-success",
                            _ => "bg-light text-dark"
                        };
                        <tr>
                            <td><code>@item.Code</code></td>
                            <td>
                                <strong>@item.Name</strong>
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    <div class="text-muted small text-truncate" style="max-width:300px">@item.Description</div>
                                }
                            </td>
                            <td><span class="badge @catBadge">@item.Category</span></td>
                            <td class="small text-muted">@(item.TypicalPreventionMeasure ?? "—")</td>
                            <td class="text-center">
                                @if (item.IncidentCount > 0)
                                {
                                    <span class="badge bg-danger rounded-pill">@item.IncidentCount</span>
                                }
                                else
                                {
                                    <span class="text-muted">0</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer text-muted small">
        Tổng: @Model.Count failure modes
    </div>
</div>
