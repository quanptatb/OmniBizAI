@model OmniBizAI.ViewModels.FailureModeEditViewModel
@using OmniBizAI.Models.Entities.Enums
@{
    ViewData["Title"] = Model.Id.HasValue ? "Chỉnh sửa Failure Mode" : "Thêm Failure Mode";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-gray-800">
        <i class="fas fa-exclamation-triangle me-2 text-warning"></i>@ViewData["Title"]
    </h1>
    <a asp-action="Index" class="btn btn-secondary shadow-sm">
        <i class="fas fa-arrow-left me-1"></i>Quay lại
    </a>
</div>

<div class="card shadow">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Code" class="form-label">Mã</label>
                    <input asp-for="Code" class="form-control" placeholder="Tự sinh nếu để trống">
                    <span asp-validation-for="Code" class="text-danger small"></span>
                </div>
                <div class="col-md-8">
                    <label asp-for="Name" class="form-label">Tên <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control">
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Category" class="form-label">Nhóm lỗi</label>
                    <select asp-for="Category" asp-items="Html.GetEnumSelectList<FailureModeCategory>()" class="form-select"></select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">&nbsp;</label>
                    <div class="form-check mt-2">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox">
                        <label asp-for="IsActive" class="form-check-label">Đang hoạt động</label>
                    </div>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label">Mô tả</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Mô tả chi tiết loại lỗi..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="TypicalPreventionMeasure" class="form-label">Biện pháp phòng ngừa tiêu biểu</label>
                    <textarea asp-for="TypicalPreventionMeasure" class="form-control" rows="3" placeholder="Kiểm tra định kỳ, bôi trơn, thay lọc..."></textarea>
                    <span asp-validation-for="TypicalPreventionMeasure" class="text-danger small"></span>
                </div>
            </div>

            <hr />
            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-1"></i>Lưu
                </button>
            </div>
        </form>
    </div>
</div>
