@model OmniBizAI.ViewModels.CommandCenterViewModel
@{
    ViewData["Title"] = "Trung tâm điều hành";
    string DeltaIcon(int delta) => delta > 0 ? "fa-arrow-up" : delta < 0 ? "fa-arrow-down" : "fa-minus";
    string DeltaColor(int delta, bool invertColor = false) =>
        delta == 0 ? "var(--text-muted)" :
        (invertColor ? delta < 0 : delta > 0) ? "var(--danger)" : "var(--success)";
    string DeltaText(int delta) => delta == 0 ? "—" : (delta > 0 ? $"+{delta}" : $"{delta}") + " vs hôm qua";
}

<style>
    .cc-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 32px; }
    .cc-card {
        background: var(--card-bg); border-radius: 16px; padding: 24px;
        border: 1px solid var(--divider); position: relative; overflow: hidden;
        transition: transform .2s, box-shadow .2s; cursor: pointer; text-decoration: none; color: inherit; display: block;
    }
    .cc-card:hover { transform: translateY(-4px); box-shadow: 0 12px 32px rgba(0,0,0,.08); }
    .cc-card::before {
        content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px;
        background: var(--card-accent, var(--apple-blue)); border-radius: 16px 16px 0 0;
    }
    .cc-card-icon { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; margin-bottom: 14px; }
    .cc-card-value { font-size: 2.2rem; font-weight: 800; line-height: 1; margin-bottom: 4px; font-feature-settings: 'tnum'; }
    .cc-card-label { font-size: .82rem; color: var(--text-muted); margin-bottom: 10px; }
    .cc-card-delta { font-size: .72rem; font-weight: 600; display: flex; align-items: center; gap: 4px; }
    .cc-card-delta i { font-size: .6rem; }

    /* Heatmap */
    .heatmap-section { margin-top: 12px; }
    .heatmap-section h3 { font-size: 1rem; font-weight: 700; margin-bottom: 16px; display: flex; align-items: center; gap: 8px; }
    .heatmap-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); gap: 8px; }
    .heatmap-cell {
        aspect-ratio: 1; border-radius: 10px; display: flex; flex-direction: column;
        align-items: center; justify-content: center; font-size: .68rem; font-weight: 600;
        padding: 6px; text-align: center; cursor: pointer; transition: transform .15s, box-shadow .15s;
        border: 1px solid var(--divider); text-decoration: none; color: inherit;
    }
    .heatmap-cell:hover { transform: scale(1.08); box-shadow: 0 4px 16px rgba(0,0,0,.12); }
    .heatmap-cell .eq-icon { font-size: 1.4rem; margin-bottom: 4px; }
    .heatmap-cell .eq-code { font-weight: 700; font-size: .72rem; }
    .heatmap-cell .eq-name { font-size: .6rem; color: var(--text-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 100%; }

    .hm-Active { background: rgba(52, 199, 89, 0.12); --card-border: var(--success); }
    .hm-Active .eq-icon { color: var(--success); }
    .hm-UnderMaintenance { background: rgba(255, 149, 0, 0.15); --card-border: #ff9500; }
    .hm-UnderMaintenance .eq-icon { color: #ff9500; }
    .hm-Inactive { background: rgba(142, 142, 147, 0.12); --card-border: #8e8e93; }
    .hm-Inactive .eq-icon { color: #8e8e93; }
    .hm-Decommissioned { background: rgba(255, 59, 48, 0.1); --card-border: var(--danger); }
    .hm-Decommissioned .eq-icon { color: var(--danger); }

    .heatmap-legend { display: flex; gap: 16px; margin-top: 12px; flex-wrap: wrap; }
    .legend-item { display: flex; align-items: center; gap: 6px; font-size: .72rem; }
    .legend-dot { width: 10px; height: 10px; border-radius: 3px; }

    @@media (max-width: 900px) { .cc-grid { grid-template-columns: repeat(2, 1fr); } }
    @@media (max-width: 600px) { .cc-grid { grid-template-columns: 1fr; } }
</style>

<div class="fade-in">
    <!-- KPI CARDS -->
    <div class="cc-grid">
        <!-- 1. Open Requests -->
        <a class="cc-card" href="/Operations?status=InProgress" style="--card-accent: var(--apple-blue);">
            <div class="cc-card-icon" style="background: rgba(0,122,255,0.12); color: var(--apple-blue);">
                <i class="fa-solid fa-list-check"></i>
            </div>
            <div class="cc-card-value" data-countup="@Model.OpenRequests">@Model.OpenRequests</div>
            <div class="cc-card-label">Yêu cầu đang mở</div>
            <div class="cc-card-delta" style="color: @DeltaColor(Model.OpenRequestsDelta, true)">
                <i class="fa-solid @DeltaIcon(Model.OpenRequestsDelta)"></i> @DeltaText(Model.OpenRequestsDelta)
            </div>
        </a>

        <!-- 2. Critical Incidents -->
        <a class="cc-card" href="/Maintenance/Incidents?severity=Critical" style="--card-accent: var(--danger);">
            <div class="cc-card-icon" style="background: rgba(255,59,48,0.12); color: var(--danger);">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <div class="cc-card-value" data-countup="@Model.CriticalIncidents">@Model.CriticalIncidents</div>
            <div class="cc-card-label">Sự cố nghiêm trọng</div>
            <div class="cc-card-delta" style="color: @DeltaColor(Model.CriticalIncidentsDelta, true)">
                <i class="fa-solid @DeltaIcon(Model.CriticalIncidentsDelta)"></i> @DeltaText(Model.CriticalIncidentsDelta)
            </div>
        </a>

        <!-- 3. Overdue PM -->
        <a class="cc-card" href="/Maintenance/PmSchedules?overdue=true" style="--card-accent: #ff9500;">
            <div class="cc-card-icon" style="background: rgba(255,149,0,0.12); color: #ff9500;">
                <i class="fa-solid fa-clock-rotate-left"></i>
            </div>
            <div class="cc-card-value" data-countup="@Model.OverduePm">@Model.OverduePm</div>
            <div class="cc-card-label">Bảo trì quá hạn</div>
            <div class="cc-card-delta" style="color: var(--text-muted)">
                <i class="fa-solid fa-minus"></i> So sánh theo lịch PM
            </div>
        </a>

        <!-- 4. Equipment in Maintenance -->
        <a class="cc-card" href="/ResourceManagement/Equipments?status=Maintenance" style="--card-accent: #5856d6;">
            <div class="cc-card-icon" style="background: rgba(88,86,214,0.12); color: #5856d6;">
                <i class="fa-solid fa-screwdriver-wrench"></i>
            </div>
            <div class="cc-card-value" data-countup="@Model.EquipmentInMaintenance">@Model.EquipmentInMaintenance</div>
            <div class="cc-card-label">Thiết bị đang bảo trì</div>
            <div class="cc-card-delta" style="color: var(--text-muted)">
                <i class="fa-solid fa-industry"></i> / @Model.EquipmentHeatmap.Count thiết bị
            </div>
        </a>

        <!-- 5. SLA Breach Today -->
        <a class="cc-card" href="/Operations?slaBreach=true" style="--card-accent: #ff3b30;">
            <div class="cc-card-icon" style="background: rgba(255,59,48,0.1); color: #ff3b30;">
                <i class="fa-solid fa-shield-halved"></i>
            </div>
            <div class="cc-card-value" data-countup="@Model.SlaBreachToday">@Model.SlaBreachToday</div>
            <div class="cc-card-label">Vi phạm SLA hôm nay</div>
            <div class="cc-card-delta" style="color: @DeltaColor(Model.SlaBreachToday - Model.SlaBreachYesterday, true)">
                <i class="fa-solid @DeltaIcon(Model.SlaBreachToday - Model.SlaBreachYesterday)"></i>
                Hôm qua: @Model.SlaBreachYesterday
            </div>
        </a>

        <!-- 6. Pending Approvals -->
        <a class="cc-card" href="/Approvals/MyTasks?status=Pending" style="--card-accent: #30b0c7;">
            <div class="cc-card-icon" style="background: rgba(48,176,199,0.12); color: #30b0c7;">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <div class="cc-card-value" data-countup="@Model.PendingApprovals">@Model.PendingApprovals</div>
            <div class="cc-card-label">Phê duyệt chờ xử lý</div>
            <div class="cc-card-delta" style="color: @DeltaColor(Model.PendingApprovalsDelta, true)">
                <i class="fa-solid @DeltaIcon(Model.PendingApprovalsDelta)"></i> @DeltaText(Model.PendingApprovalsDelta)
            </div>
        </a>
    </div>

    <!-- EQUIPMENT HEATMAP -->
    @if (Model.EquipmentHeatmap.Any())
    {
        <div class="heatmap-section">
            <h3><i class="fa-solid fa-grip"></i> Bản đồ thiết bị</h3>
            <div class="heatmap-grid">
                @foreach (var eq in Model.EquipmentHeatmap)
                {
                    <a class="heatmap-cell hm-@eq.Status" href="/ResourceManagement/EquipmentDetail/@eq.Id"
                       title="@eq.Name — @eq.Status@(eq.Location != null ? $" ({eq.Location})" : "")">
                        <span class="eq-icon">
                            <i class="fa-solid @(eq.Status == "Active" ? "fa-circle-check" : eq.Status == "UnderMaintenance" ? "fa-wrench" : eq.Status == "Inactive" ? "fa-power-off" : "fa-ban")"></i>
                        </span>
                        <span class="eq-code">@eq.Code</span>
                        <span class="eq-name">@eq.Name</span>
                    </a>
                }
            </div>
            <div class="heatmap-legend">
                <div class="legend-item"><div class="legend-dot" style="background: rgba(52,199,89,0.5)"></div> Hoạt động (@Model.EquipmentHeatmap.Count(e => e.Status == "Active"))</div>
                <div class="legend-item"><div class="legend-dot" style="background: rgba(255,149,0,0.5)"></div> Đang bảo trì (@Model.EquipmentHeatmap.Count(e => e.Status == "UnderMaintenance"))</div>
                <div class="legend-item"><div class="legend-dot" style="background: rgba(142,142,147,0.5)"></div> Ngừng (@Model.EquipmentHeatmap.Count(e => e.Status == "Inactive"))</div>
                <div class="legend-item"><div class="legend-dot" style="background: rgba(255,59,48,0.4)"></div> Thanh lý (@Model.EquipmentHeatmap.Count(e => e.Status == "Decommissioned"))</div>
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
    // Count-up animation
    document.querySelectorAll('[data-countup]').forEach(el => {
        const target = parseInt(el.dataset.countup) || 0;
        if (target === 0) return;
        let current = 0;
        const step = Math.max(1, Math.ceil(target / 40));
        const interval = setInterval(() => {
            current += step;
            if (current >= target) { current = target; clearInterval(interval); }
            el.textContent = current.toLocaleString('vi-VN');
        }, 25);
    });
</script>
}
