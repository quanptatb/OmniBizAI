@model OmniBizAI.ViewModels.SparePartRequisitionDetailViewModel
@using OmniBizAI.Models.Entities.Enums
@{
    ViewData["Title"] = $"Phiếu {Model.Code}";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string Badge(SparePartRequisitionStatus s) => s switch
    {
        SparePartRequisitionStatus.Draft => "bg-light text-dark border",
        SparePartRequisitionStatus.Submitted => "bg-info text-white",
        SparePartRequisitionStatus.Approved => "bg-primary",
        SparePartRequisitionStatus.Issued => "bg-success",
        SparePartRequisitionStatus.Rejected => "bg-danger",
        SparePartRequisitionStatus.Cancelled => "bg-dark",
        _ => "bg-light text-dark"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="h4 mb-0">@Model.Code <span class="badge @Badge(Model.Status) ms-2">@Model.Status</span></h2>
        <div class="text-muted small mt-1">@Model.Reason</div>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">← Danh sách</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success py-2">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger py-2">@TempData["ErrorMessage"]</div>
}

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-white"><strong>Phụ tùng yêu cầu</strong></div>
            <div class="table-responsive">
                <table class="table mb-0 align-middle">
                    <thead class="table-light">
                        <tr><th>Mã</th><th>Tên</th><th class="text-end">SL</th><th class="text-end">Tồn kho</th><th class="text-end">Đơn giá</th><th>Ghi chú</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var l in Model.Lines)
                        {
                            <tr class="@(l.StockOnHand < l.Quantity ? "table-warning" : "")">
                                <td>@l.SparePartCode</td>
                                <td>@l.SparePartName <small class="text-muted">(@l.Unit)</small></td>
                                <td class="text-end">@l.Quantity</td>
                                <td class="text-end">@l.StockOnHand</td>
                                <td class="text-end">@(l.UnitCost?.ToString("N0") ?? "—")</td>
                                <td>@l.Notes</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.Status == SparePartRequisitionStatus.Rejected && !string.IsNullOrWhiteSpace(Model.RejectionReason))
        {
            <div class="alert alert-danger py-2"><strong>Lý do từ chối:</strong> @Model.RejectionReason</div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-white"><strong>Thông tin</strong></div>
            <div class="card-body">
                <div class="d-flex justify-content-between"><span class="text-muted">Người yêu cầu</span><span>@Model.RequestedByName</span></div>
                @if (!string.IsNullOrWhiteSpace(Model.LinkedWorkOrderCode))
                {
                    <div class="d-flex justify-content-between"><span class="text-muted">Work Order</span><span>@Model.LinkedWorkOrderCode</span></div>
                }
                @if (Model.ApprovedAt.HasValue)
                {
                    <div class="d-flex justify-content-between"><span class="text-muted">Người duyệt</span><span>@Model.ApprovedByName</span></div>
                    <div class="d-flex justify-content-between"><span class="text-muted">Duyệt lúc</span><span>@Model.ApprovedAt.Value.LocalDateTime.ToString("dd/MM HH:mm")</span></div>
                }
                @if (Model.IssuedAt.HasValue)
                {
                    <div class="d-flex justify-content-between"><span class="text-muted">Xuất kho lúc</span><span>@Model.IssuedAt.Value.LocalDateTime.ToString("dd/MM HH:mm")</span></div>
                    <div class="d-flex justify-content-between"><span class="text-muted">GI</span><span>@Model.IssuedGoodsIssueNo</span></div>
                }
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-white"><strong>Hành động</strong></div>
            <div class="card-body">
                @if (Model.NextStatuses.Contains(SparePartRequisitionStatus.Submitted))
                {
                    <form method="post" asp-action="Submit" class="mb-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button class="btn btn-info text-white w-100"><i class="fas fa-paper-plane me-1"></i>Gửi duyệt</button>
                    </form>
                }
                @if (Model.NextStatuses.Contains(SparePartRequisitionStatus.Approved))
                {
                    <form method="post" asp-action="Approve" class="mb-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input name="note" class="form-control form-control-sm mb-1" placeholder="Ghi chú duyệt..." />
                        <button class="btn btn-primary w-100"><i class="fas fa-check me-1"></i>Duyệt</button>
                    </form>
                }
                @if (Model.NextStatuses.Contains(SparePartRequisitionStatus.Issued))
                {
                    <form method="post" asp-action="Issue" class="mb-2" onsubmit="return confirm('Xác nhận xuất kho? Sẽ sinh Goods Issue và giảm tồn kho.')">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button class="btn btn-success w-100"><i class="fas fa-truck me-1"></i>Xuất kho</button>
                    </form>
                }
                @if (Model.NextStatuses.Contains(SparePartRequisitionStatus.Rejected))
                {
                    <form method="post" asp-action="Reject" class="mb-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input name="reason" class="form-control form-control-sm mb-1" placeholder="Lý do từ chối..." required />
                        <button class="btn btn-outline-danger w-100"><i class="fas fa-times me-1"></i>Từ chối</button>
                    </form>
                }
                @if (Model.NextStatuses.Contains(SparePartRequisitionStatus.Cancelled))
                {
                    <form method="post" asp-action="Cancel" class="mb-2" onsubmit="return confirm('Huỷ phiếu?')">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button class="btn btn-outline-dark w-100"><i class="fas fa-ban me-1"></i>Huỷ</button>
                    </form>
                }
                @if (Model.NextStatuses.Count == 0)
                {
                    <div class="text-center text-muted py-2">Phiếu đã đóng.</div>
                }
            </div>
        </div>
    </div>
</div>
