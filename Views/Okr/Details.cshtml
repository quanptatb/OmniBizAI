@model OmniBizAI.ViewModels.OkrDetailViewModel
@{ ViewData["Title"] = "Chi tiết OKR"; ViewData["Breadcrumb"] = "<a href='/Okr' style='color:var(--apple-blue);text-decoration:none'>OKR</a> <i class='fa-solid fa-chevron-right' style='font-size:.6rem;margin:0 6px;color:var(--text-muted)'></i> <span>Chi tiết</span>"; }

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4 border-0 shadow-sm" role="alert" style="border-radius:12px;background:rgba(25,135,84,0.1);color:#198754">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4 border-0 shadow-sm" role="alert" style="border-radius:12px;background:rgba(220,53,69,0.1);color:#dc3545">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Header with actions -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="page-title mb-1">@Model.ObjectiveName</h4>
        <div class="d-flex gap-2 align-items-center">
            <span class="badge bg-primary">@Model.Level</span>
            <span class="badge bg-info">@Model.Cycle</span>
            <span class="badge" style="background:@(Model.Status == "Active" ? "var(--success)" : Model.Status == "Completed" ? "var(--apple-blue)" : Model.Status == "Draft" ? "var(--text-muted)" : "var(--danger)");color:#fff">@Model.Status</span>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm"><i class="fa-solid fa-pen me-1"></i>Sửa</a>
        @if (Model.Status == "Draft") {
            <form asp-action="Activate" asp-route-id="@Model.Id" method="post" class="d-inline">@Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success btn-sm"><i class="fa-solid fa-play me-1"></i>Kích hoạt</button>
            </form>
        }
        @if (Model.Status == "Active") {
            <form asp-action="Close" asp-route-id="@Model.Id" method="post" class="d-inline">@Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger btn-sm"><i class="fa-solid fa-stop me-1"></i>Đóng</button>
            </form>
        }
        <div class="dropdown d-inline-block">
            <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-three-dots-vertical me-1"></i>Thao tác
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="border-radius: 10px; font-size: 0.88rem; min-width: 210px;">
                <li>
                    <a class="dropdown-item py-2 btn-add-kr" href="#" data-id="@Model.Id" data-name="@Model.ObjectiveName" data-bs-toggle="modal" data-bs-target="#addKrModal">
                        <i class="bi bi-plus-circle text-warning me-2 fw-bold" style="color:#ffc107!important"></i> Thêm KR
                    </a>
                </li>
                <li>
                    <a class="dropdown-item py-2 btn-suggest-kr" href="#" data-id="@Model.Id" data-name="@Model.ObjectiveName" data-bs-toggle="modal" data-bs-target="#suggestKrModal">
                        <i class="bi bi-magic text-info me-2" style="color:#0dcaf0!important"></i> AI Gợi ý KR
                    </a>
                </li>
                <li>
                    <a class="dropdown-item py-2 btn-allocations" href="#" data-id="@Model.Id" data-name="@Model.ObjectiveName" data-bs-toggle="modal" data-bs-target="#allocationsModal">
                        <i class="bi bi-person-plus text-primary me-2"></i> Phân bổ nhân sự/phòng ban
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa OKR này?')">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="dropdown-item py-2 text-danger">
                            <i class="bi bi-trash text-danger me-2"></i> Xóa OKR
                        </button>
                    </form>
                </li>
            </ul>
        </div>
        <a asp-action="Index" class="btn btn-light btn-sm"><i class="fa-solid fa-arrow-left me-1"></i>Quay lại</a>
    </div>
</div>

<!-- Progress bar -->
<div class="content-card mb-4">
    <div class="card-body-custom">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 style="font-weight:600;margin:0">Tiến độ tổng thể</h5>
            <span style="font-size:1.2rem;font-weight:700;color:var(--apple-blue)">@Model.TotalProgress%</span>
        </div>
        <div class="progress" style="height:12px;border-radius:var(--r-md)">
            <div class="progress-bar @OmniBizAI.Helpers.ProgressHelper.GetProgressColorClass(Model.TotalProgress)" style="width:@Math.Min(Model.TotalProgress,100)%"></div>
        </div>
    </div>
</div>

<!-- Key Results with update form -->
<div class="content-card mb-4">
    <div class="card-header-custom"><h5><i class="fa-solid fa-key" style="color:var(--warning)"></i> Key Results (@Model.KeyResults.Count)</h5></div>
    <div class="card-body-custom p-0">
        <table class="data-table">
            <thead><tr><th class="ps-3">Key Result</th><th class="text-center">ĐV</th><th class="text-end">Mục tiêu</th><th class="text-end">Thực tế</th><th style="width:200px">Tiến độ</th><th class="pe-3">Cập nhật</th></tr></thead>
            <tbody>
                @foreach (var kr in Model.KeyResults) {
                    <tr>
                        <td class="ps-3" style="font-weight:500">@kr.KeyResultName @if(kr.IsInverse){<span class="badge bg-warning text-dark" style="font-size:.6rem">↓</span>}</td>
                        <td class="text-center" style="font-size:.82rem">@kr.Unit</td>
                        <td class="text-end" style="font-weight:600">@kr.TargetValue.ToString("N0")</td>
                        <td class="text-end">@kr.CurrentValue.ToString("N0")</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="progress flex-grow-1" style="height:6px;border-radius:var(--r-sm)"><div class="progress-bar @OmniBizAI.Helpers.ProgressHelper.GetProgressColorClass(kr.Progress)" style="width:@Math.Min(kr.Progress,100)%"></div></div>
                                <span style="font-size:.78rem;font-weight:600;min-width:40px">@kr.Progress%</span>
                            </div>
                        </td>
                        <td class="pe-3">
                            @if (Model.Status == "Active") {
                                <form asp-action="UpdateKeyResult" method="post" class="d-flex gap-1">@Html.AntiForgeryToken()
                                    <input type="hidden" name="KeyResultId" value="@kr.Id" />
                                    <input type="hidden" name="OkrId" value="@Model.Id" />
                                    <input type="number" name="CurrentValue" value="@kr.CurrentValue" class="form-control form-control-sm" style="width:80px;font-size:.78rem" step="1" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary" style="font-size:.68rem;padding:2px 6px"><i class="fa-solid fa-check"></i></button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Links -->
<div class="row g-3">
    @if (Model.MissionLinks.Any()) {
        <div class="col-md-4"><div class="content-card h-100"><div class="card-header-custom"><h5><i class="fa-solid fa-star" style="color:var(--warning)"></i> Sứ mệnh</h5></div><div class="card-body-custom"><ul class="list-unstyled mb-0">@foreach(var m in Model.MissionLinks){<li class="mb-1" style="font-size:.85rem"><i class="fa-solid fa-check-circle text-success me-1"></i>@m</li>}</ul></div></div></div>
    }
    @if (Model.DepartmentLinks.Any()) {
        <div class="col-md-4"><div class="content-card h-100"><div class="card-header-custom"><h5><i class="fa-solid fa-sitemap" style="color:var(--apple-blue)"></i> Phòng ban</h5></div><div class="card-body-custom"><ul class="list-unstyled mb-0">@foreach(var d in Model.DepartmentLinks){<li class="mb-1" style="font-size:.85rem"><i class="fa-solid fa-building me-1" style="color:var(--apple-blue)"></i>@d</li>}</ul></div></div></div>
    }
    @if (Model.EmployeeLinks.Any()) {
        <div class="col-md-4"><div class="content-card h-100"><div class="card-header-custom"><h5><i class="fa-solid fa-users" style="color:var(--success)"></i> Nhân viên</h5></div><div class="card-body-custom"><ul class="list-unstyled mb-0">@foreach(var e in Model.EmployeeLinks){<li class="mb-1" style="font-size:.85rem"><i class="fa-solid fa-user me-1" style="color:var(--apple-blue)"></i>@e</li>}</ul></div></div></div>
    }
</div>

<!-- MODALS -->

<!-- Modal 1: Add KR -->
<div class="modal fade" id="addKrModal" tabindex="-1" aria-labelledby="addKrModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="addKrModalLabel"><i class="bi bi-plus-circle-fill text-warning me-2"></i>Thêm Key Result mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddKeyResult" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="okrId" id="addKrOkrId" />
                <div class="modal-body py-3">
                    <p class="text-muted small mb-3">Mục tiêu: <strong id="addKrOkrName"></strong></p>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Tên Key Result *</label>
                        <input type="text" name="keyResultName" class="form-control" placeholder="Nhập kết quả then chốt..." required style="border-radius: 8px;" />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small fw-bold">Đơn vị đo</label>
                            <input type="text" name="unit" class="form-control" placeholder="vd: %, VNĐ, khách..." style="border-radius: 8px;" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small fw-bold">Mục tiêu số *</label>
                            <input type="number" name="targetValue" class="form-control" required min="0.01" step="any" value="100" style="border-radius: 8px;" />
                        </div>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="isInverse" id="addKrIsInverse" value="true">
                        <label class="form-check-label small fw-bold" for="addKrIsInverse">Đo lường nghịch (vd: giảm chi phí, giảm lỗi)</label>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="border-radius: 8px;">Đóng</button>
                    <button type="submit" class="btn btn-warning text-dark fw-bold" style="border-radius: 8px;">Lưu lại</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal 2: AI Suggest KR -->
<div class="modal fade" id="suggestKrModal" tabindex="-1" aria-labelledby="suggestKrModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="suggestKrModalLabel"><i class="bi bi-magic text-info me-2"></i>AI Gợi ý Key Results</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="SaveSuggestedKeyResults" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="okrId" id="suggestKrOkrId" />
                <div class="modal-body py-3">
                    <p class="text-muted small mb-3">Mục tiêu của bạn: <strong id="suggestKrOkrName"></strong></p>
                    
                    <div id="aiLoading" class="text-center py-5">
                        <div class="spinner-border text-info" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-2 text-muted small">Gemini AI đang phân tích mục tiêu và gợi ý kết quả then chốt...</p>
                    </div>

                    <div id="aiError" class="alert alert-danger d-none" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i><span id="aiErrorMessage">Lỗi khi gọi AI gợi ý.</span>
                    </div>

                    <div id="aiSuggestionsContainer" class="d-none">
                        <p class="small fw-bold mb-2">Chọn các kết quả then chốt muốn thêm:</p>
                        <div id="aiSuggestionsList" class="d-flex flex-column gap-3">
                            <!-- suggestions populated here -->
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="border-radius: 8px;">Đóng</button>
                    <button type="submit" id="btnSaveSuggestions" class="btn btn-info text-white fw-bold d-none" style="border-radius: 8px;">Thêm các KR đã chọn</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal 3: Allocations -->
<div class="modal fade" id="allocationsModal" tabindex="-1" aria-labelledby="allocationsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="allocationsModalLabel"><i class="bi bi-person-plus-fill text-primary me-2"></i>Phân bổ Nhân sự & Phòng ban</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="UpdateAllocations" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="okrId" id="allocationsOkrId" />
                <div class="modal-body py-3">
                    <p class="text-muted small mb-3">Mục tiêu: <strong id="allocationsOkrName"></strong></p>

                    <div id="allocationsLoading" class="text-center py-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>

                    <div id="allocationsContent" class="d-none">
                        <ul class="nav nav-tabs mb-3" id="allocationsTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="departments-tab" data-bs-toggle="tab" data-bs-target="#departments-panel" type="button" role="tab" aria-selected="true">Phòng ban</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="employees-tab" data-bs-toggle="tab" data-bs-target="#employees-panel" type="button" role="tab" aria-selected="false">Nhân viên</button>
                            </li>
                        </ul>
                        <div class="tab-content" id="allocationsTabContent">
                            <div class="tab-pane fade show active" id="departments-panel" role="tabpanel" aria-labelledby="departments-tab">
                                <div class="row g-2" id="departmentsCheckboxContainer" style="max-height: 250px; overflow-y: auto; padding: 5px;">
                                    <!-- departments checkboxes -->
                                </div>
                            </div>
                            <div class="tab-pane fade" id="employees-panel" role="tabpanel" aria-labelledby="employees-tab">
                                <div class="row g-2" id="employeesCheckboxContainer" style="max-height: 250px; overflow-y: auto; padding: 5px;">
                                    <!-- employees checkboxes -->
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="border-radius: 8px;">Đóng</button>
                    <button type="submit" class="btn btn-primary" style="border-radius: 8px;">Lưu phân bổ</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Modal Add KR
        var addKrModal = document.getElementById('addKrModal');
        if (addKrModal) {
            addKrModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var id = button.getAttribute('data-id');
                var name = button.getAttribute('data-name');
                
                document.getElementById('addKrOkrId').value = id;
                document.getElementById('addKrOkrName').innerText = name;
            });
        }

        // Modal AI Suggest
        var suggestKrModal = document.getElementById('suggestKrModal');
        if (suggestKrModal) {
            suggestKrModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var id = button.getAttribute('data-id');
                var name = button.getAttribute('data-name');
                
                document.getElementById('suggestKrOkrId').value = id;
                document.getElementById('suggestKrOkrName').innerText = name;

                // Reset modal state
                document.getElementById('aiLoading').classList.remove('d-none');
                document.getElementById('aiError').classList.add('d-none');
                document.getElementById('aiSuggestionsContainer').classList.add('d-none');
                document.getElementById('btnSaveSuggestions').classList.add('d-none');
                document.getElementById('aiSuggestionsList').innerHTML = '';

                // Call suggest action
                fetch('/Okr/SuggestKeyResults/' + id, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                })
                .then(response => response.json())
                .then(data => {
                    document.getElementById('aiLoading').classList.add('d-none');
                    if (data.success && data.keyResults && data.keyResults.length > 0) {
                        var list = document.getElementById('aiSuggestionsList');
                        data.keyResults.forEach((kr, index) => {
                            var checked = index < 3 ? 'checked' : ''; // Default select top 3
                            var html = `
                                <div class="p-3 border rounded mb-2" style="background: var(--kpi-bg-secondary); border-color: var(--kpi-border)!important;">
                                    <div class="form-check">
                                        <input class="form-check-input ai-kr-checkbox" type="checkbox" value="${index}" id="aiKr_${index}" ${checked}>
                                        <label class="form-check-label fw-bold d-block" for="aiKr_${index}" style="cursor: pointer;">
                                            ${kr.name}
                                        </label>
                                        <div class="mt-2 d-flex gap-3 text-muted small">
                                            <span><strong>Đơn vị:</strong> ${kr.unit || 'N/A'}</span>
                                            <span><strong>Mục tiêu:</strong> ${kr.targetValue}</span>
                                            <span><strong>Đo ngược:</strong> ${kr.isInverse ? 'Có' : 'Không'}</span>
                                        </div>
                                        <input type="hidden" name="keyResults[${index}].Name" value="${kr.name}" class="ai-input-${index}" ${checked ? '' : 'disabled'} />
                                        <input type="hidden" name="keyResults[${index}].Unit" value="${kr.unit || ''}" class="ai-input-${index}" ${checked ? '' : 'disabled'} />
                                        <input type="hidden" name="keyResults[${index}].TargetValue" value="${kr.targetValue}" class="ai-input-${index}" ${checked ? '' : 'disabled'} />
                                        <input type="hidden" name="keyResults[${index}].IsInverse" value="${kr.isInverse ? 'true' : 'false'}" class="ai-input-${index}" ${checked ? '' : 'disabled'} />
                                    </div>
                                </div>
                            `;
                            list.insertAdjacentHTML('beforeend', html);
                        });

                        // Event listener for suggestion checkboxes to enable/disable hidden inputs
                        document.querySelectorAll('.ai-kr-checkbox').forEach(checkbox => {
                            checkbox.addEventListener('change', function() {
                                var idx = this.value;
                                var inputs = document.querySelectorAll('.ai-input-' + idx);
                                inputs.forEach(input => {
                                    input.disabled = !this.checked;
                                });
                            });
                        });

                        document.getElementById('aiSuggestionsContainer').classList.remove('d-none');
                        document.getElementById('btnSaveSuggestions').classList.remove('d-none');
                    } else {
                        document.getElementById('aiError').classList.remove('d-none');
                        document.getElementById('aiErrorMessage').innerText = data.message || "Không có gợi ý nào từ AI.";
                    }
                })
                .catch(err => {
                    document.getElementById('aiLoading').classList.add('d-none');
                    document.getElementById('aiError').classList.remove('d-none');
                    document.getElementById('aiErrorMessage').innerText = "Đã xảy ra lỗi hệ thống: " + err;
                });
            });
        }

        // Modal Allocations
        var allocationsModal = document.getElementById('allocationsModal');
        if (allocationsModal) {
            allocationsModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var id = button.getAttribute('data-id');
                var name = button.getAttribute('data-name');
                
                document.getElementById('allocationsOkrId').value = id;
                document.getElementById('allocationsOkrName').innerText = name;

                document.getElementById('allocationsLoading').classList.remove('d-none');
                document.getElementById('allocationsContent').classList.add('d-none');
                document.getElementById('departmentsCheckboxContainer').innerHTML = '';
                document.getElementById('employeesCheckboxContainer').innerHTML = '';

                fetch('/Okr/GetAllocations/' + id)
                .then(response => response.json())
                .then(data => {
                    document.getElementById('allocationsLoading').classList.add('d-none');
                    if (data.success) {
                        var depContainer = document.getElementById('departmentsCheckboxContainer');
                        data.departments.forEach(dep => {
                            var checked = data.selectedDepartmentIds.includes(dep.id) ? 'checked' : '';
                            var html = `
                                <div class="col-md-6 mb-2">
                                    <div class="form-check p-2 border rounded h-100" style="background: var(--kpi-bg-secondary); border-color: var(--kpi-border)!important;">
                                        <input class="form-check-input ms-1" type="checkbox" name="departmentIds" value="${dep.id}" id="dep_${dep.id}" ${checked}>
                                        <label class="form-check-label small fw-semibold ms-2" for="dep_${dep.id}" style="cursor: pointer;">
                                            ${dep.name}
                                        </label>
                                    </div>
                                </div>
                            `;
                            depContainer.insertAdjacentHTML('beforeend', html);
                        });

                        var empContainer = document.getElementById('employeesCheckboxContainer');
                        data.employees.forEach(emp => {
                            var checked = data.selectedEmployeeIds.includes(emp.id) ? 'checked' : '';
                            var html = `
                                <div class="col-md-6 mb-2">
                                    <div class="form-check p-2 border rounded h-100" style="background: var(--kpi-bg-secondary); border-color: var(--kpi-border)!important;">
                                        <input class="form-check-input ms-1" type="checkbox" name="employeeIds" value="${emp.id}" id="emp_${emp.id}" ${checked}>
                                        <label class="form-check-label small fw-semibold ms-2" for="emp_${emp.id}" style="cursor: pointer;">
                                            ${emp.name}
                                        </label>
                                    </div>
                                </div>
                            `;
                            empContainer.insertAdjacentHTML('beforeend', html);
                        });

                        document.getElementById('allocationsContent').classList.remove('d-none');
                    }
                });
            });
        }
    });
</script>
}
