@{
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    var loginUrl = Url.Action("Login", "Account") ?? "/Account/Login";
    var dashboardUrl = Url.Action("Index", "Dashboard") ?? "/Dashboard";
    var operationsCreateUrl = Url.Action("Create", "Operations") ?? "/Operations/Create";
    var planCreateUrl = Url.Action("Create", "OperationPlans") ?? "/OperationPlans/Create";
    var aiCopilotUrl = Url.Action("Index", "AiInsights") ?? "/AiInsights";
    var reportsUrl = Url.Action("Dashboard", "Reports") ?? "/Reports/Dashboard";
    var profileUrl = Url.Action("Index", "Profile") ?? "/Profile";

    ViewData["Title"] = "Welcome to OmniBizAI";
    ViewData["HideAppShell"] = true;

    var primaryUrl = isAuthenticated ? dashboardUrl : loginUrl;
    var primaryLabel = isAuthenticated ? "Vào Dashboard" : "Bắt đầu miễn phí";

    var moduleCards = new[]
    {
        new { Icon = "fa-calendar-alt", Title = "Kế hoạch & Lịch trình", Desc = "Điều phối công việc thông minh, tối ưu thời gian", Href = isAuthenticated ? "/OperationPlans" : loginUrl, Accent = "blue" },
        new { Icon = "fa-list-check", Title = "Yêu cầu vận hành", Desc = "Khởi tạo và theo dõi tiến độ yêu cầu mượt mà", Href = isAuthenticated ? "/Operations" : loginUrl, Accent = "green" },
        new { Icon = "fa-chart-line", Title = "Mục tiêu KPI / OKR", Desc = "Liên kết mục tiêu chiến lược với hành động thực tế", Href = isAuthenticated ? "/Okr/Dashboard" : loginUrl, Accent = "amber" },
        new { Icon = "fa-robot", Title = "AI Copilot", Desc = "Trợ lý phân tích, đưa ra khuyến nghị chiến lược", Href = isAuthenticated ? aiCopilotUrl : loginUrl, Accent = "purple" },
        new { Icon = "fa-layer-group", Title = "Tài nguyên & Bảo trì", Desc = "Quản lý thiết bị và phân bổ nguồn lực hiệu quả", Href = isAuthenticated ? "/ResourceManagement" : loginUrl, Accent = "orange" },
        new { Icon = "fa-chart-pie", Title = "Báo cáo điều hành", Desc = "Góc nhìn 360 độ bằng dữ liệu thời gian thực", Href = isAuthenticated ? reportsUrl : loginUrl, Accent = "red" }
    };
}

@section Styles {
    <style>
        /* Apple-style minimalist landing page */
        body.landing-body {
            background: var(--parchment, #f5f5f7);
            color: var(--text-primary, #1d1d1f);
            overflow-x: hidden;
            margin: 0;
            padding: 0;
            font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
        }

        /* Ambient Backgrounds (Light & Subtle) */
        .ambient-wrapper {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            z-index: -2;
            overflow: hidden;
            background: var(--parchment, #f5f5f7);
        }
        
        .glow-sphere {
            position: absolute;
            border-radius: 50%;
            filter: blur(120px);
            opacity: 0.6;
            animation: floatGlow 20s infinite alternate ease-in-out;
        }

        .glow-1 { top: -20%; left: -10%; width: 50vw; height: 50vw; background: radial-gradient(circle, rgba(0,113,227,0.15), transparent 70%); }
        .glow-2 { bottom: -20%; right: -10%; width: 60vw; height: 60vw; background: radial-gradient(circle, rgba(175,82,222,0.1), transparent 70%); animation-delay: -5s; }

        @@keyframes floatGlow {
            0% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(3%, 3%) scale(1.05); }
            100% { transform: translate(-3%, -3%) scale(0.95); }
        }

        /* Navigation */
        .top-nav {
            position: fixed;
            top: 0; left: 0; width: 100%;
            padding: 16px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 100;
            backdrop-filter: saturate(180%) blur(20px);
            -webkit-backdrop-filter: saturate(180%) blur(20px);
            background: rgba(255, 255, 255, 0.72);
            border-bottom: 1px solid var(--divider, rgba(0,0,0,0.05));
            transition: all 0.3s ease;
            box-sizing: border-box;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            color: var(--text-primary, #1d1d1f);
        }

        .brand-icon {
            width: 40px;
            height: 40px;
            background: var(--apple-blue, #0071e3);
            color: #fff;
            border-radius: var(--r-sm, 10px);
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 1.1rem;
            box-shadow: 0 4px 12px rgba(0,113,227,0.3);
        }

        .brand-text {
            font-weight: 700;
            font-size: 1.15rem;
            letter-spacing: -0.02em;
        }

        .brand-text span {
            display: block;
            font-weight: 500;
            color: var(--text-secondary, #48484a);
            font-size: 0.75rem;
        }

        .auth-actions {
            display: flex;
            gap: 12px;
            align-items: center;
        }

        /* Buttons */
        .btn-ghost {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            border-radius: var(--r-pill, 9999px);
            background: transparent;
            color: var(--text-primary, #1d1d1f);
            font-weight: 500;
            font-size: 0.9rem;
            text-decoration: none;
            transition: all var(--ease-fast, 0.15s);
            cursor: pointer;
            border: none;
        }

        .btn-ghost:hover {
            background: rgba(0,0,0,0.05);
        }

        .btn-primary-action {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 24px;
            border-radius: var(--r-pill, 9999px);
            background: var(--apple-blue, #0071e3);
            color: #fff;
            font-weight: 600;
            font-size: 0.95rem;
            text-decoration: none;
            transition: all var(--ease-fast, 0.15s);
            border: none;
            cursor: pointer;
        }

        .btn-primary-action:hover {
            background: var(--apple-blue-focus, #0077ed);
            transform: scale(1.02);
            box-shadow: 0 4px 14px rgba(0,113,227,0.3);
            color: #fff;
        }

        .btn-secondary-action {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 24px;
            border-radius: var(--r-pill, 9999px);
            background: var(--canvas, #ffffff);
            border: 1px solid var(--hairline, #d5d5da);
            color: var(--text-primary, #1d1d1f);
            font-weight: 600;
            font-size: 0.95rem;
            text-decoration: none;
            transition: all var(--ease-fast, 0.15s);
            box-shadow: var(--shadow-card, 0 1px 4px rgba(0,0,0,0.05));
        }

        .btn-secondary-action:hover {
            background: var(--pearl, #fafafc);
            border-color: var(--text-muted, #8e8e93);
            transform: scale(1.02);
            color: var(--text-primary, #1d1d1f);
        }

        /* Hero Section */
        .hero-section {
            min-height: 90vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 140px 20px 80px;
            position: relative;
            z-index: 10;
        }

        .hero-kicker {
            padding: 6px 16px;
            background: rgba(0,113,227,0.1);
            color: var(--apple-blue, #0071e3);
            border-radius: var(--r-pill, 9999px);
            font-size: 0.8rem;
            font-weight: 600;
            margin-bottom: 24px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            animation: slideDown 0.8s ease-out forwards;
            opacity: 0;
            transform: translateY(-20px);
        }

        .hero-title {
            font-size: clamp(3rem, 6vw, 5rem);
            font-weight: 800;
            color: var(--text-primary, #1d1d1f);
            line-height: 1.05;
            letter-spacing: -0.04em;
            margin-bottom: 24px;
            max-width: 900px;
            animation: slideUp 0.8s ease-out 0.2s forwards;
            opacity: 0;
            transform: translateY(30px);
        }

        .hero-title .highlight {
            background: linear-gradient(135deg, var(--apple-blue, #0071e3), #af52de);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .hero-subtitle {
            font-size: 1.2rem;
            color: var(--text-secondary, #48484a);
            line-height: 1.5;
            margin-bottom: 40px;
            max-width: 650px;
            font-weight: 400;
            animation: slideUp 0.8s ease-out 0.4s forwards;
            opacity: 0;
            transform: translateY(30px);
        }

        .hero-actions {
            display: flex;
            gap: 16px;
            animation: slideUp 0.8s ease-out 0.6s forwards;
            opacity: 0;
            transform: translateY(30px);
            flex-wrap: wrap;
            justify-content: center;
        }

        /* Stats Section */
        .stats-section {
            display: flex;
            gap: 80px;
            justify-content: center;
            padding: 60px 20px;
            background: var(--canvas, #ffffff);
            border-top: 1px solid var(--divider, #ebebf0);
            border-bottom: 1px solid var(--divider, #ebebf0);
            margin: 0 auto;
            width: 100%;
        }

        .stat-item {
            text-align: center;
        }

        .stat-value {
            font-size: 3rem;
            font-weight: 700;
            color: var(--text-primary, #1d1d1f);
            margin-bottom: 4px;
            letter-spacing: -0.03em;
        }

        .stat-label {
            color: var(--text-secondary, #48484a);
            font-size: 0.9rem;
            font-weight: 500;
        }

        /* Features/Modules Section */
        .modules-section {
            padding: 100px 20px;
            max-width: 1200px;
            margin: 0 auto;
            z-index: 10;
            position: relative;
        }

        .section-header {
            text-align: center;
            margin-bottom: 60px;
        }

        .section-header h2 {
            font-size: 2.5rem;
            font-weight: 800;
            margin-bottom: 16px;
            color: var(--text-primary, #1d1d1f);
            letter-spacing: -0.03em;
        }

        .section-header p {
            font-size: 1.1rem;
            color: var(--text-secondary, #48484a);
            max-width: 600px;
            margin: 0 auto;
        }

        .modules-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 24px;
        }

        .module-card {
            background: var(--canvas, #ffffff);
            border: 1px solid var(--hairline, #d5d5da);
            border-radius: var(--r-lg, 18px);
            padding: 32px;
            text-decoration: none;
            color: var(--text-primary, #1d1d1f);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            flex-direction: column;
            box-shadow: var(--shadow-card, 0 1px 4px rgba(0,0,0,0.05));
        }

        .module-card:hover {
            transform: translateY(-4px) scale(1.01);
            box-shadow: var(--shadow-elevated, 0 8px 24px rgba(0,0,0,0.1));
            border-color: transparent;
            color: var(--text-primary, #1d1d1f);
        }

        .module-icon-wrapper {
            width: 56px;
            height: 56px;
            border-radius: var(--r-md, 14px);
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 1.5rem;
            margin-bottom: 20px;
            transition: all 0.3s ease;
        }

        /* Accent colors matching site.css stat-icons */
        .module-icon-wrapper.blue { background: rgba(0,113,227,.1); color: var(--apple-blue, #0071e3); }
        .module-icon-wrapper.green { background: rgba(48,209,88,.1); color: var(--success, #30d158); }
        .module-icon-wrapper.amber { background: rgba(255,159,10,.1); color: var(--warning, #ff9f0a); }
        .module-icon-wrapper.cyan { background: rgba(100,210,255,.1); color: var(--info, #64d2ff); }
        .module-icon-wrapper.purple { background: rgba(175,82,222,.1); color: #af52de; }
        .module-icon-wrapper.orange { background: rgba(255,149,0,.1); color: #ff9500; }
        .module-icon-wrapper.red { background: rgba(255,69,58,.1); color: var(--danger, #ff453a); }

        .module-card:hover .module-icon-wrapper {
            transform: scale(1.1);
        }

        .module-info h3 {
            margin: 0 0 8px 0;
            font-size: 1.2rem;
            font-weight: 700;
            letter-spacing: -0.01em;
        }

        .module-info p {
            margin: 0 0 24px 0;
            font-size: 0.95rem;
            color: var(--text-secondary, #48484a);
            line-height: 1.5;
            flex-grow: 1;
        }

        .module-link {
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--apple-blue, #0071e3);
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-top: auto;
            transition: transform 0.2s;
        }

        .module-card:hover .module-link {
            transform: translateX(4px);
        }

        /* CTA Section */
        .cta-section {
            padding: 80px 20px 100px;
            text-align: center;
            position: relative;
            z-index: 10;
        }

        .cta-box {
            max-width: 800px;
            margin: 0 auto;
            background: var(--canvas, #ffffff);
            border: 1px solid var(--hairline, #d5d5da);
            border-radius: 32px;
            padding: 60px 40px;
            box-shadow: var(--shadow-elevated, 0 8px 24px rgba(0,0,0,0.1));
        }

        .cta-box h2 {
            font-size: 2.5rem;
            font-weight: 800;
            margin-bottom: 16px;
            letter-spacing: -0.03em;
        }

        .cta-box p {
            font-size: 1.1rem;
            color: var(--text-secondary, #48484a);
            margin-bottom: 32px;
        }

        /* Footer */
        footer {
            text-align: center;
            padding: 32px 20px;
            color: var(--text-muted, #8e8e93);
            font-size: 0.85rem;
            border-top: 1px solid var(--divider, #ebebf0);
            background: var(--parchment, #f5f5f7);
            position: relative;
            z-index: 10;
        }

        /* Animations */
        @@keyframes slideDown { from { opacity: 0; transform: translateY(-20px); } to { opacity: 1; transform: translateY(0); } }
        @@keyframes slideUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }

        @@media (max-width: 768px) {
            .top-nav { padding: 16px 20px; }
            .hero-title { font-size: 2.5rem; }
            .stats-section { flex-direction: column; gap: 40px; padding: 40px 20px; }
            .hero-actions { flex-direction: column; width: 100%; max-width: 320px; }
            .hero-actions .btn-primary-action, .hero-actions .btn-secondary-action { width: 100%; justify-content: center; }
        }
    </style>
}

<!-- Ambient Background -->
<div class="ambient-wrapper">
    <div class="glow-sphere glow-1"></div>
    <div class="glow-sphere glow-2"></div>
</div>

<nav class="top-nav">
    <a href="/" class="brand">
        <div class="brand-icon"><i class="fa-solid fa-brain"></i></div>
        <div class="brand-text">
            OmniBizAI
            <span>Smart Operations</span>
        </div>
    </a>

    <div class="auth-actions">
        @if (isAuthenticated)
        {
            <a href="@dashboardUrl" class="btn-ghost"><i class="fa-solid fa-gauge-high"></i> Dashboard</a>
            <a href="@profileUrl" class="btn-ghost"><i class="fa-solid fa-user"></i> Hồ sơ</a>
            <form method="post" asp-controller="Account" asp-action="Logout" class="m-0 p-0" style="margin: 0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-ghost" style="color: var(--danger, #ff453a);"><i class="fa-solid fa-right-from-bracket"></i> Đăng xuất</button>
            </form>
        }
        else
        {
            <a href="@loginUrl" class="btn-ghost">Đăng nhập</a>
            <a href="@loginUrl" class="btn-primary-action">Dùng thử miễn phí</a>
        }
    </div>
</nav>

<main>
    <section class="hero-section">
        <div class="hero-kicker">
            <i class="fa-solid fa-rocket"></i>
            @(isAuthenticated ? "Chào mừng trở lại, " + User.Identity?.Name : "Nền tảng Quản trị Doanh nghiệp AI")
        </div>

        <h1 class="hero-title">
            @if (isAuthenticated)
            {
                <span>Điều phối doanh nghiệp <br/><span class="highlight">gọn, sâu và liền mạch.</span></span>
            }
            else
            {
                <span>Vận hành thông minh hơn,<br/> tăng trưởng <span class="highlight">vượt bậc.</span></span>
            }
        </h1>

        <p class="hero-subtitle">
            @(isAuthenticated
                ? "Bắt đầu ngày làm việc của bạn bằng cách theo dõi các chỉ số quan trọng, xử lý yêu cầu vận hành hoặc nhờ AI Copilot phân tích dữ liệu chuyên sâu."
                : "Giải pháp toàn diện giúp doanh nghiệp tự động hóa quy trình, theo dõi mục tiêu OKR/KPI và tối ưu hóa nguồn lực với sức mạnh của Trí tuệ nhân tạo.")
        </p>

        <div class="hero-actions">
            <a href="@primaryUrl" class="btn-primary-action">
                @primaryLabel <i class="fa-solid fa-arrow-right"></i>
            </a>
            @if (isAuthenticated)
            {
                <a href="@planCreateUrl" class="btn-secondary-action">
                    <i class="fa-solid fa-calendar-plus"></i> Lập kế hoạch
                </a>
            }
            else
            {
                <a href="#features" class="btn-secondary-action">
                    <i class="fa-regular fa-circle-play"></i> Khám phá tính năng
                </a>
            }
        </div>
    </section>

    @if (!isAuthenticated)
    {
        <section class="stats-section">
            <div class="stat-item">
                <div class="stat-value">300%</div>
                <div class="stat-label">Tăng hiệu suất</div>
            </div>
            <div class="stat-item">
                <div class="stat-value">24/7</div>
                <div class="stat-label">AI Giám sát</div>
            </div>
            <div class="stat-item">
                <div class="stat-value">10k+</div>
                <div class="stat-label">Doanh nghiệp tin dùng</div>
            </div>
            <div class="stat-item">
                <div class="stat-value">99.9%</div>
                <div class="stat-label">Uptime</div>
            </div>
        </section>
    }

    <section id="features" class="modules-section">
        <div class="section-header">
            <h2>Giải pháp của chúng tôi</h2>
            <p>Hệ sinh thái công cụ quản trị đa năng, kết nối mọi phòng ban trong một nền tảng duy nhất được tăng cường bởi AI.</p>
        </div>

        <div class="modules-grid">
            @foreach (var card in moduleCards)
            {
                <a href="@card.Href" class="module-card">
                    <div class="module-icon-wrapper @card.Accent">
                        <i class="fa-solid @card.Icon"></i>
                    </div>
                    <div class="module-info">
                        <h3>@card.Title</h3>
                        <p>@card.Desc</p>
                    </div>
                    <div class="module-link">
                        Tìm hiểu thêm <i class="fa-solid fa-chevron-right" style="font-size: 0.75rem;"></i>
                    </div>
                </a>
            }
        </div>
    </section>

    @if (!isAuthenticated)
    {
        <section class="cta-section">
            <div class="cta-box">
                <h2>Sẵn sàng chuyển đổi số?</h2>
                <p>Đăng ký ngay hôm nay để trải nghiệm toàn bộ tính năng cao cấp của OmniBizAI trong 14 ngày không cần thẻ tín dụng.</p>
                <a href="@loginUrl" class="btn-primary-action" style="font-size: 1.05rem; padding: 14px 32px;">
                    Bắt đầu miễn phí ngay <i class="fa-solid fa-bolt"></i>
                </a>
            </div>
        </section>
    }
</main>

<footer>
    <p>&copy; @DateTime.Now.Year OmniBizAI - Nền tảng quản trị thông minh. Bản quyền đã được bảo hộ.</p>
</footer>
