@model OmniBizAI.ViewModels.SparePartCreateViewModel
@{ ViewData["Title"] = "Thêm Phụ Tùng"; Layout = "~/Views/Shared/_Layout.cshtml"; }
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="page-title mb-1"><i class="fas fa-boxes text-secondary me-2"></i>Thêm Phụ Tùng Vào Kho</h4>
        <p class="mb-0" style="color:var(--text-muted);font-size:.84rem">Thêm mới thông tin phụ tùng, linh kiện phục vụ cho việc bảo trì thiết bị.</p>
    </div>
    <a asp-action="SpareParts" class="btn btn-light"><i class="fa-solid fa-arrow-left me-1"></i>Quay lại danh sách</a>
</div>

<div class="row">
    <div class="col-xl-8">
        <div class="content-card mb-4">
            <div class="card-header-custom">
                <h5><i class="fas fa-cubes me-1"></i> Thông Tin Phụ Tùng</h5>
            </div>
            <div class="card-body-custom">
                <form asp-action="CreateSparePart" method="post">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label">Tên phụ tùng <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" placeholder="Ví dụ: Vòng bi SKF 6205..." />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Đơn vị</label>
                            <select asp-for="Unit" class="form-select">
                                <option value="Cái">Cái</option><option value="Bộ">Bộ</option><option value="Mét">Mét</option>
                                <option value="Lít">Lít</option><option value="Kg">Kg</option><option value="Cuộn">Cuộn</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Nhà sản xuất</label>
                            <input asp-for="Manufacturer" class="form-control" placeholder="SKF, Bosch, Siemens..." />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Mã linh kiện (Part No.)</label>
                            <input asp-for="PartNumber" class="form-control" placeholder="SKF-6205, ABB-3GHZ..." />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Danh mục</label>
                            <select asp-for="Category" class="form-select">
                                <option value="Bearing">Vòng bi (Bearing)</option><option value="Seal">Phớt dầu (Seal)</option>
                                <option value="Filter">Lọc (Filter)</option><option value="Belt">Dây đai (Belt)</option>
                                <option value="Electrical">Linh kiện điện</option><option value="Mechanical">Cơ khí</option>
                                <option value="Hydraulic">Thủy lực</option><option value="Other">Khác</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Số lượng ban đầu</label>
                            <input asp-for="InitialStock" type="number" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Tồn kho tối thiểu <span class="text-danger">*</span></label>
                            <input asp-for="MinimumStock" type="number" class="form-control" />
                            <span asp-validation-for="MinimumStock" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Đơn giá (VNĐ)</label>
                            <input asp-for="UnitPrice" type="number" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Ghi chú</label>
                            <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Thông số kỹ thuật, nơi mua..."></textarea>
                        </div>
                    </div>
                    <hr class="my-4" />
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <button type="submit" class="btn btn-secondary px-5">Thêm Vào Kho</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
