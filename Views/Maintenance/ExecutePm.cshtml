@model OmniBizAI.ViewModels.ExecutePmViewModel
@{ ViewData["Title"] = "Thực Hiện PM"; Layout = "~/Views/Shared/_Layout.cshtml"; }
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="page-title mb-1"><i class="fas fa-play-circle text-success me-2"></i>Ghi Nhận Thực Hiện Bảo Trì PM</h4>
        <p class="mb-0" style="color:var(--text-muted);font-size:.84rem">Cập nhật kết quả thực hiện và chi phí cho đợt bảo trì phòng ngừa.</p>
    </div>
    <a asp-action="PmSchedules" class="btn btn-light"><i class="fa-solid fa-arrow-left me-1"></i>Quay lại danh sách</a>
</div>

<div class="row">
    <div class="col-xl-6 col-lg-8">
        <div class="content-card mb-4 border-success">
            <div class="card-header-custom bg-success text-white">
                <h5><i class="fas fa-check-square me-1"></i> Kết Quả Thực Hiện</h5>
            </div>
            <div class="card-body-custom">
                <form asp-action="ExecutePm" method="post">
                    <input type="hidden" asp-for="PmScheduleId" />
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Ngày hoàn thành <span class="text-danger">*</span></label>
                            <input asp-for="CompletedDate" type="date" class="form-control" />
                            <span asp-validation-for="CompletedDate" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Kỹ thuật viên thực hiện</label>
                            <select asp-for="TechnicianUserId" class="form-select">
                                <option value="">-- Như đã phân công --</option>
                                @foreach (var t in Model.Technicians) { <option value="@t.Value">@t.Text</option> }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Công việc đã thực hiện</label>
                            <textarea asp-for="WorkDone" class="form-control" rows="3" placeholder="Mô tả những gì đã làm, phụ tùng đã thay..."></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Chi phí bảo trì (VNĐ)</label>
                            <input asp-for="Cost" type="number" class="form-control" placeholder="0" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Ngày PM tiếp theo</label>
                            <input asp-for="NextDueDate" type="date" class="form-control" />
                        </div>
                    </div>
                    <hr class="my-4" />
                    <button type="submit" class="btn btn-success w-100 py-2">
                        <i class="fas fa-check-circle me-2"></i>Xác Nhận Hoàn Thành PM
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
