@model OmniBizAI.ViewModels.IncidentCreateViewModel
@{ ViewData["Title"] = "Báo Cáo Sự Cố"; Layout = "~/Views/Shared/_Layout.cshtml"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>

        <h4 class="page-title mb-1"><i class="fas fa-exclamation-triangle text-danger me-2"></i>Báo Cáo Sự Cố Thiết Bị</h4>
        <p class="mb-0" style="color:var(--text-muted);font-size:.84rem">Ghi nhận thông tin thiết bị gặp sự cố để kỹ thuật viên xử lý kịp thời.</p>
    </div>
    <a asp-action="Incidents" class="btn btn-light"><i class="fa-solid fa-arrow-left me-1"></i>Quay lại danh sách</a>
</div>

<div class="row justify-content-center">
    <div class="col-xl-8">
        <div class="content-card mb-4" style="border: 1px solid rgba(255, 59, 48, 0.2)">
            <div class="card-header-custom" style="background: rgba(255, 59, 48, 0.05)">
                <h5><i class="fas fa-info-circle"></i> Thông Tin Sự Cố</h5>
            </div>
            <div class="card-body-custom">
                <form asp-action="ReportIncident" method="post">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Thiết bị bị sự cố <span class="text-danger">*</span></label>
                            <select asp-for="EquipmentId" class="form-select" required>
                                <option value="">-- Chọn thiết bị --</option>
                                @foreach (var e in Model.Equipments) { <option value="@e.Value">@e.Text</option> }
                            </select>
                            <span asp-validation-for="EquipmentId" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Mô tả sự cố <span class="text-danger">*</span></label>
                            <input asp-for="Title" class="form-control" placeholder="Ví dụ: Máy bơm bị rò rỉ dầu, Động cơ phát tiếng ồn bất thường..." />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Chi tiết sự cố</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Mô tả thêm về tình trạng, triệu chứng..."></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Mức độ nghiêm trọng <span class="text-danger">*</span></label>
                            <select asp-for="Severity" class="form-select">
                                <option value="Low">🟢 Thấp - Không ảnh hưởng sản xuất</option>
                                <option value="Medium" selected>🟡 Trung bình - Giảm hiệu suất</option>
                                <option value="High">🟠 Cao - Cần xử lý sớm</option>
                                <option value="Critical">🔴 Nghiêm trọng - Ngừng máy hoàn toàn</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Phân công kỹ thuật viên</label>
                            <select asp-for="AssignedTechnicianId" class="form-select">
                                <option value="">-- Chưa phân công --</option>
                                @foreach (var t in Model.Technicians) { <option value="@t.Value">@t.Text</option> }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Thời điểm xảy ra sự cố</label>
                            <input asp-for="OccurredAt" type="text" class="form-control datetimepicker" placeholder="dd/mm/yyyy HH:mm" />
                        </div>
                    </div>
                    <hr class="my-4" />
                    <div class="alert alert-warning small py-2 mb-4"><i class="fas fa-info-circle me-2"></i>Với sự cố mức <strong>Cao / Nghiêm trọng</strong>, thiết bị sẽ tự động chuyển sang trạng thái <strong>Đang bảo trì</strong>.</div>
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <button type="submit" class="btn btn-danger px-5"><i class="fas fa-exclamation-triangle me-1"></i>Gửi Báo Cáo Sự Cố</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
}
@section Scripts { 
    <partial name="_ValidationScriptsPartial" /> 
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://npmcdn.com/flatpickr/dist/l10n/vn.js"></script>
    <script>
        flatpickr(".datetimepicker", {
            enableTime: true,
            dateFormat: "d/m/Y H:i",
            locale: "vn"
        });
    </script>
}
