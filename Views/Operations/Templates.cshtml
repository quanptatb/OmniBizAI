@model OmniBizAI.ViewModels.OperationRequestTemplateListViewModel
@{
    ViewData["Title"] = "Template yêu cầu vận hành";
    ViewData["Breadcrumb"] = "<a href='/Operations' style='color:var(--apple-blue);text-decoration:none'>Vận hành</a> <i class=\"fa-solid fa-chevron-right mx-2\" style=\"font-size:.6rem;color:var(--text-muted)\"></i> <span>Templates</span>";
    string PriorityLabel(string p) => EnumHelper.Label<PriorityLevel>(p);
    string TypeLabel(string? t) => t switch {
        "IT_SUPPORT"     => "Hỗ trợ IT",
        "PROCUREMENT"    => "Đề xuất mua sắm",
        "FACILITY"       => "Bảo trì cơ sở vật chất",
        "Maintenance_PM" => "Bảo trì phòng ngừa",
        "Maintenance_CM" => "Bảo trì khắc phục",
        "Maintenance"    => "Bảo trì",
        "SERVICE"        => "Cung cấp dịch vụ/Sản phẩm",
        "OTHER"          => "Khác",
        _                => t ?? ""
    };
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert" style="border-radius:12px;border:none;background:rgba(52,199,89,.12);color:#1d7a37">
        <i class="fa-solid fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert" style="border-radius:12px;border:none;background:rgba(255,59,48,.08);color:#c33">
        <i class="fa-solid fa-circle-exclamation me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="stat-card"><div class="stat-icon blue"><i class="fa-solid fa-layer-group"></i></div><div class="stat-value">@Model.Items.Count</div><div class="stat-label">Tổng template</div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card"><div class="stat-icon green"><i class="fa-solid fa-toggle-on"></i></div><div class="stat-value">@Model.ActiveCount</div><div class="stat-label">Đang dùng</div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card"><div class="stat-icon purple"><i class="fa-solid fa-repeat"></i></div><div class="stat-value">@Model.TotalUsage</div><div class="stat-label">Lượt dùng</div></div>
    </div>
</div>

<div class="content-card mb-4">
    <div class="card-body-custom py-3">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-8">
                <label class="form-label text-muted small fw-bold">Tìm template</label>
                <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Tiêu đề hoặc loại yêu cầu..." style="border-radius:8px">
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1" style="border-radius:8px"><i class="fa-solid fa-filter me-1"></i>Lọc</button>
                <a asp-action="TemplateCreate" class="btn btn-success" style="border-radius:8px"><i class="fa-solid fa-plus me-1"></i>Tạo template</a>
            </div>
        </form>
    </div>
</div>

<div class="content-card">
    <div class="card-header-custom">
        <h5><i class="fa-solid fa-layer-group"></i> Danh sách template</h5>
        <a asp-action="Index" class="btn btn-light btn-sm border" style="border-radius:8px"><i class="fa-solid fa-arrow-left me-1"></i>Danh sách yêu cầu</a>
    </div>
    <div class="card-body-custom p-0">
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th class="ps-4">Template</th>
                        <th>Loại</th>
                        <th>Phòng ban</th>
                        <th>Ưu tiên</th>
                        <th>Dòng mặc định</th>
                        <th>Lượt dùng</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="ps-4">
                                <div style="font-weight:700">@item.Title</div>
                                <small class="text-muted">Tạo: @item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</small>
                            </td>
                            <td>@TypeLabel(item.Type)</td>
                            <td>@item.Department</td>
                            <td>@PriorityLabel(item.Priority)</td>
                            <td>@item.DefaultLineCount</td>
                            <td>
                                <span style="font-weight:700">@item.UsageCount</span>
                                @if (item.LastUsedAt.HasValue)
                                {
                                    <div class="small text-muted">@item.LastUsedAt.Value.ToLocalTime().ToString("dd/MM HH:mm")</div>
                                }
                            </td>
                            <td>
                                <span class="status-badge-soft @(item.IsActive ? "badge-on-track" : "badge-behind")"><span class="status-dot"></span>@(item.IsActive ? "Đang dùng" : "Tạm tắt")</span>
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="Create" asp-route-templateId="@item.Id" class="btn btn-sm btn-light border" style="border-radius:8px"><i class="fa-solid fa-wand-magic-sparkles me-1"></i>Dùng</a>
                                <a asp-action="TemplateEdit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" style="border-radius:8px"><i class="fa-solid fa-pen"></i></a>
                                <form asp-action="TemplateDelete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Xóa template này?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" style="border-radius:8px"><i class="fa-solid fa-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="8" class="text-center py-5 text-muted"><i class="fa-solid fa-layer-group fa-2x d-block mb-2 opacity-50"></i>Chưa có template</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
