@model OmniBizAI.ViewModels.OperationRequestTemplateEditViewModel
@{
    ViewData["Title"] = "Tạo template vận hành";
    ViewData["Breadcrumb"] = "<a href='/Operations/Templates' style='color:var(--apple-blue);text-decoration:none'>Templates</a> <i class=\"fa-solid fa-chevron-right mx-2\" style=\"font-size:.6rem;color:var(--text-muted)\"></i> <span>Tạo mới</span>";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="content-card">
            <div class="card-header-custom">
                <h5><i class="fa-solid fa-layer-group"></i> Tạo template</h5>
            </div>
            <div class="card-body-custom">
                <form asp-action="TemplateCreate" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    @await Html.PartialAsync("_OperationTemplateFields", Model)
                    <div style="border-top:1px solid var(--divider);padding-top:20px" class="d-flex justify-content-end gap-2">
                        <a asp-action="Templates" class="btn btn-light">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-save me-1"></i>Lưu template</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
