@model OmniBizAI.ViewModels.CompanySettingsViewModel
@{
    Layout = "~/Views/Shared/_SettingsLayout.cshtml";
    ViewData["Title"] = "Cài đặt công ty";
    ViewData["Breadcrumb"] = "<span>Hệ thống</span> <i class='fa-solid fa-chevron-right' style='font-size:.6rem;margin:0 6px;color:var(--text-muted)'></i> <span>Cài đặt công ty</span>";
}

<div class="content-card fade-in" style="max-width:720px; border-radius: 16px;">
    <div class="card-header-custom" style="padding: 20px 24px;">
        <h5 class="mb-0"><i class="fa-solid fa-building-columns text-primary me-1"></i> Thông tin doanh nghiệp</h5>
    </div>
    
    <div class="card-body-custom" style="padding: 24px;">
        <form method="post" asp-action="Company">
            @Html.AntiForgeryToken()
            
            <!-- Section 1: Basic Info -->
            <div class="d-flex align-items-center gap-2 mb-3">
                <span style="width: 4px; height: 16px; background: var(--apple-blue); border-radius: 2px; display: inline-block;"></span>
                <h6 class="mb-0 text-primary" style="font-size: 0.88rem; font-weight: 600;">Thông tin cơ bản</h6>
            </div>
            
            <div class="row g-3 mb-4">
                <div class="col-md-12">
                    <label class="form-label">Tên doanh nghiệp <span class="text-danger">*</span></label>
                    <input asp-for="CompanyName" class="form-input" placeholder="VD: Công ty Cổ phần OmniBiz" />
                    <span asp-validation-for="CompanyName" class="text-danger" style="font-size: 0.75rem; display: block; margin-top: 4px;"></span>
                </div>
                
                <div class="col-md-6">
                    <label class="form-label">Loại hình doanh nghiệp</label>
                    <input asp-for="BusinessType" class="form-input" placeholder="VD: Công ty TNHH, Công ty Cổ phần..." />
                </div>
                
                <div class="col-md-6">
                    <label class="form-label">Ngành nghề kinh doanh</label>
                    <input asp-for="Industry" class="form-input" placeholder="VD: Công nghệ thông tin, Thương mại..." />
                </div>
            </div>
            
            <hr style="border-color: var(--divider); margin: 24px 0;" />
            
            <!-- Section 2: Technical Info -->
            <div class="d-flex align-items-center gap-2 mb-3">
                <span style="width: 4px; height: 16px; background: var(--text-muted); border-radius: 2px; display: inline-block;"></span>
                <h6 class="mb-0 text-secondary" style="font-size: 0.88rem; font-weight: 600;">Cấu hình Kỹ thuật &amp; Tenant</h6>
            </div>
            
            <div class="row g-3">
                <div class="col-md-7">
                    <label class="form-label">Mã Tenant (Tenant ID)</label>
                    <div class="position-relative">
                        <input asp-for="TenantCode" class="form-input" readonly style="background: var(--parchment); font-family: monospace; font-size: 0.8rem; font-weight: 600; padding-right: 36px; border-color: var(--divider) !important;" />
                        <i class="fa-solid fa-lock position-absolute end-0 top-50 translate-middle-y me-3 text-muted" style="font-size: 0.72rem;" title="Mã Tenant không thể thay đổi"></i>
                    </div>
                    <small class="text-muted mt-1 d-block" style="font-size: 0.72rem;">Mã định danh duy nhất cho cơ sở dữ liệu của phân hệ tenant này.</small>
                </div>
                
                <div class="col-md-5">
                    <label class="form-label">Mã hồ sơ DN (Profile Code)</label>
                    <input asp-for="ProfileCode" class="form-input" placeholder="VD: PROFILE_OMNIBIZ" />
                </div>
            </div>
            
            <div class="d-flex gap-2 mt-4 pt-2">
                <button type="submit" class="btn-primary-custom" style="padding: 9px 24px; border-radius: 8px;">
                    <i class="fa-solid fa-save me-1"></i> Lưu thay đổi
                </button>
            </div>
        </form>
    </div>
</div>
