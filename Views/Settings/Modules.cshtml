@model OmniBizAI.ViewModels.ModuleListViewModel
@{
    Layout = "~/Views/Shared/_SettingsLayout.cshtml";
    ViewData["Title"] = "Quản lý Modules";
    ViewData["Breadcrumb"] = "<a href='/Settings' style='color:var(--text-muted);text-decoration:none;transition:color 0.2s;' onmouseover='this.style.color=\"var(--apple-blue)\"' onmouseout='this.style.color=\"var(--text-muted)\"'>Thiết lập</a> <i class='fa-solid fa-chevron-right' style='font-size:.6rem;margin:0 6px;color:var(--text-muted)'></i> <span>Quản lý Modules</span>";
}

<style>
    .modules-container {
        animation: fadeIn 0.4s ease;
    }

    .module-card {
        border: 1px solid var(--divider);
        border-radius: 16px;
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        background: var(--canvas);
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .module-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.05);
        border-color: var(--apple-blue);
    }

    .module-icon-wrapper {
        width: 54px;
        height: 54px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        color: #fff;
        margin: 0 auto 18px;
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.06);
        transition: transform 0.3s ease;
    }

    .module-card:hover .module-icon-wrapper {
        transform: scale(1.1) rotate(5deg);
    }

    /* Status badge style overrides */
    .module-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.72rem;
        font-weight: 600;
        border: 1px solid transparent;
        transition: all 0.2s ease;
    }

    .module-badge.enabled {
        background: rgba(48, 209, 88, 0.08);
        color: #1c9a44;
        border-color: rgba(48, 209, 88, 0.2);
    }

    .module-badge.disabled {
        background: var(--parchment);
        color: var(--text-muted);
        border-color: var(--divider);
    }

    .status-dot-pulse {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        display: inline-block;
    }

    .status-dot-pulse.enabled {
        background-color: #30d158;
        box-shadow: 0 0 0 0 rgba(48, 209, 88, 0.6);
        animation: pulseGreen 2s infinite;
    }

    .status-dot-pulse.disabled {
        background-color: #8e8e93;
    }

    @@keyframes pulseGreen {
        0% {
            box-shadow: 0 0 0 0 rgba(48, 209, 88, 0.5);
        }
        70% {
            box-shadow: 0 0 0 6px rgba(48, 209, 88, 0);
        }
        100% {
            box-shadow: 0 0 0 0 rgba(48, 209, 88, 0);
        }
    }

    .btn-toggle-module {
        font-size: 0.78rem !important;
        font-weight: 600 !important;
        padding: 8px 16px !important;
        border-radius: 10px !important;
        width: 100%;
        transition: all 0.2s ease;
    }

    .btn-toggle-module.btn-outline-danger:hover {
        background: #ff3b30 !important;
        border-color: #ff3b30 !important;
        color: #fff !important;
        box-shadow: 0 4px 12px rgba(255, 59, 48, 0.15);
    }

    .btn-toggle-module.btn-primary:hover {
        box-shadow: 0 4px 12px rgba(0, 113, 227, 0.15);
    }
</style>

<div class="modules-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="page-title mb-1 fw-bold"><i class="fa-solid fa-puzzle-piece text-primary me-2"></i>Quản lý Modules</h4>
            <p class="text-muted mb-0" style="font-size:.82rem">Bật hoặc tắt các phân hệ để tối ưu giao diện và tài nguyên hệ thống</p>
        </div>
    </div>

    <div class="row g-4">
        @foreach (var m in Model.Items) {
            var isEnabled = m.Status == "Enabled";
            
            // Premium gradient backgrounds based on module code
            var gradient = m.ModuleCode.ToLower() switch {
                var s when s.Contains("finance") || s.Contains("expense") || s.Contains("budget") || s.Contains("cash") => "linear-gradient(135deg, #FF9500, #FF5E3A)",
                var s when s.Contains("hr") || s.Contains("employee") || s.Contains("leave") || s.Contains("position") => "linear-gradient(135deg, #00C6FF, #0072FF)",
                var s when s.Contains("kpi") || s.Contains("okr") || s.Contains("eval") || s.Contains("vision") => "linear-gradient(135deg, #AF52DE, #5856D6)",
                var s when s.Contains("crm") || s.Contains("customer") || s.Contains("vendor") || s.Contains("product") => "linear-gradient(135deg, #30D158, #1C9A44)",
                var s when s.Contains("operation") || s.Contains("workflow") || s.Contains("maintenance") || s.Contains("resource") => "linear-gradient(135deg, #5AC8FA, #0071E3)",
                _ => "linear-gradient(135deg, #8E8E93, #636366)"
            };
            
            <div class="col-md-6 col-lg-4 col-xl-3 fade-in">
                <div class="module-card h-100 p-4 text-center">
                    <div>
                        <div class="module-icon-wrapper" style="background: @gradient;">
                            <i class="fa-solid @m.Icon"></i>
                        </div>
                        
                        <h6 style="font-weight: 700; margin-bottom: 4px; font-size: 0.9rem; color: var(--text-primary);">@m.DisplayName</h6>
                        <p style="font-size: 0.72rem; color: var(--text-muted); margin-bottom: 16px; font-family: monospace; letter-spacing: 0.02em;">@m.ModuleCode</p>
                        
                        <div class="mb-2">
                            <span class="module-badge @(isEnabled ? "enabled" : "disabled")">
                                <span class="status-dot-pulse @(isEnabled ? "enabled" : "disabled")"></span>
                                @(isEnabled ? "Đang hoạt động" : "Đã tạm dừng")
                            </span>
                        </div>
                    </div>
                    
                    <div class="mt-4 pt-2">
                        <form asp-action="ToggleModule" asp-route-id="@m.Id" method="post">
                            @Html.AntiForgeryToken()
                            @if (isEnabled)
                            {
                                <button type="submit" class="btn btn-outline-danger btn-toggle-module" onclick="return confirm('Bạn chắc chắn muốn tắt phân hệ @m.DisplayName?')">
                                    <i class="fa-solid fa-power-off me-1"></i> Tắt module
                                </button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-primary btn-toggle-module" style="background: var(--apple-blue); border-color: var(--apple-blue);">
                                    <i class="fa-solid fa-bolt me-1"></i> Kích hoạt
                                </button>
                            }
                        </form>
                    </div>
                </div>
            </div>
        }
        @if (!Model.Items.Any()) {
            <div class="col-12">
                <div class="content-card" style="border-radius: 16px;">
                    <div class="card-body-custom text-center py-5" style="color:var(--text-muted)">
                        <i class="fa-solid fa-box-open fa-2x mb-2 opacity-50"></i>
                        <div>Chưa có phân hệ nào được cấu hình trong hệ thống</div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
