@{
    Layout = "~/Views/Shared/_SettingsLayout.cshtml";
    ViewData["Title"] = "Thiết lập hệ thống";
    ViewData["Breadcrumb"] = "<span>Thiết lập hệ thống</span>";

    var company = ViewBag.Company as OmniBizAI.ViewModels.CompanySettingsViewModel;
    var modulesCount = (int)(ViewBag.ModulesCount ?? 0);
    var enabledModulesCount = (int)(ViewBag.EnabledModulesCount ?? 0);
    var theme = ViewBag.Theme as OmniBizAI.ViewModels.ThemeSettingsViewModel;
    var parametersCount = (int)(ViewBag.ParametersCount ?? 0);
    var enumLabelsCount = (int)(ViewBag.EnumLabelsCount ?? 0);
    var backupCount = (int)(ViewBag.BackupCount ?? 0);
    var auditLogsCount = (int)(ViewBag.AuditLogsCount ?? 0);
}

<style>
    /* Premium Settings Dashboard Styling - Cardless List Layout */
    .settings-overview-container {
        animation: fadeIn 0.4s ease;
    }

    .settings-welcome-banner {
        border-bottom: 1px solid var(--divider);
        padding-bottom: 20px;
        margin-bottom: 28px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
    }

    .settings-welcome-banner h4 {
        font-weight: 700;
        margin-bottom: 6px;
        letter-spacing: -0.02em;
        background: linear-gradient(135deg, var(--text-primary), var(--apple-blue));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .settings-welcome-banner p {
        font-size: 0.84rem;
        color: var(--text-muted);
        margin: 0;
    }

    /* System Status Bar style - Row-based, border separators */
    .system-stat-bar {
        display: flex;
        flex-wrap: wrap;
        border: 1px solid var(--divider);
        border-radius: 12px;
        background: var(--canvas);
        margin-bottom: 32px;
        overflow: hidden;
    }

    .stat-col {
        flex: 1 1 200px;
        padding: 20px 24px;
        border-right: 1px solid var(--divider);
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .stat-col:last-child {
        border-right: none;
    }

    .stat-col-label {
        font-size: 0.68rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-muted);
    }

    .stat-col-value {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--text-primary);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .stat-col-value.text-blue {
        color: var(--apple-blue);
    }

    .stat-col-desc {
        font-size: 0.72rem;
        color: var(--text-muted);
    }

    /* Tabular Settings Directory */
    .settings-section-title {
        font-size: 0.9rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        color: var(--text-primary);
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .settings-section-title span.indicator {
        width: 3.5px;
        height: 14px;
        border-radius: 2px;
        background: var(--apple-blue);
        display: inline-block;
    }

    .settings-directory-list {
        display: flex;
        flex-direction: column;
        border: 1px solid var(--divider);
        border-radius: 12px;
        background: var(--canvas);
        overflow: hidden;
        margin-bottom: 32px;
    }

    .directory-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 24px;
        border-bottom: 1px solid var(--divider);
        text-decoration: none !important;
        color: inherit !important;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
    }

    .directory-item:last-child {
        border-bottom: none;
    }

    .directory-item:hover {
        background: rgba(0, 113, 227, 0.02);
    }

    .directory-left {
        display: flex;
        align-items: center;
        gap: 16px;
        flex: 1;
        min-width: 0;
    }

    .directory-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.05rem;
        color: #fff;
        flex-shrink: 0;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.04);
        transition: transform 0.25s ease;
    }

    .directory-item:hover .directory-icon {
        transform: scale(1.08) rotate(3deg);
    }

    .directory-info {
        min-width: 0;
    }

    .directory-title {
        font-size: 0.88rem;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 2px;
    }

    .directory-desc {
        font-size: 0.76rem;
        color: var(--text-muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        padding-right: 16px;
    }

    .directory-right {
        display: flex;
        align-items: center;
        gap: 16px;
        flex-shrink: 0;
    }

    .directory-meta {
        font-size: 0.78rem;
        font-weight: 550;
        color: var(--text-secondary);
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .directory-arrow {
        font-size: 0.75rem;
        color: var(--text-muted);
        transition: all 0.2s ease;
    }

    .directory-item:hover .directory-arrow {
        color: var(--apple-blue);
        transform: translateX(3px);
    }

    .tenant-badge {
        font-family: monospace;
        font-size: 0.72rem;
        font-weight: 600;
        background: var(--parchment);
        border: 1px solid var(--divider);
        padding: 3px 8px;
        border-radius: 6px;
        color: var(--text-secondary);
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(6px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Responsive details */
    @@media(max-width: 991.98px) {
        .system-stat-bar {
            flex-direction: column;
        }
        .stat-col {
            border-right: none;
            border-bottom: 1px solid var(--divider);
        }
        .stat-col:last-child {
            border-bottom: none;
        }
    }
</style>

<div class="settings-overview-container">
    <!-- Header Welcome Banner -->
    <div class="settings-welcome-banner">
        <div>
            <h4>Hệ thống Cài đặt & Cấu hình</h4>
            <p>Tùy chỉnh các tham số nghiệp vụ, quản lý phân hệ, sao lưu dữ liệu và cấu hình giao diện cho tenant của bạn.</p>
        </div>
        <div>
            <span class="status-badge-soft badge-on-track" style="font-weight: 600; padding: 6px 14px; font-size: 0.78rem; display: flex; align-items: center; gap: 6px;">
                <span class="pulse-dot" style="width: 7px; height: 7px; background-color: var(--success, #34c759)"></span>Đang hoạt động
            </span>
        </div>
    </div>

    <!-- System Status Bar -->
    <div class="system-stat-bar shadow-sm">
        <div class="stat-col">
            <span class="stat-col-label">Tổ chức/Doanh nghiệp</span>
            <span class="stat-col-value text-blue">
                <i class="fa-solid fa-briefcase opacity-75"></i>
                @(company?.CompanyName ?? "Chưa thiết lập")
            </span>
            <span class="stat-col-desc">Tenant hoạt động chính</span>
        </div>
        <div class="stat-col">
            <span class="stat-col-label">Mã định danh Tenant</span>
            <span class="stat-col-value">
                <span class="tenant-badge">@(company?.TenantCode ?? "N/A")</span>
            </span>
            <span class="stat-col-desc">Tenant ID kỹ thuật</span>
        </div>
        <div class="stat-col">
            <span class="stat-col-label">Hệ thống &amp; Phân hệ</span>
            <span class="stat-col-value">
                <i class="fa-solid fa-toggle-on text-success opacity-75"></i>
                @enabledModulesCount / @modulesCount
            </span>
            <span class="stat-col-desc">Các modules đang bật</span>
        </div>
    </div>

    <!-- HỆ THỐNG SECTION -->
    <div class="settings-section-title">
        <span class="indicator"></span>
        <span>Cấu hình hệ thống</span>
    </div>
    
    <div class="settings-directory-list shadow-sm">
        <!-- 1. Cài đặt công ty -->
        <a href="@Url.Action("Company", "Settings")" class="directory-item">
            <div class="directory-left">
                <div class="directory-icon" style="background: linear-gradient(135deg, #0072FF, #00C6FF);">
                    <i class="fa-solid fa-building-columns"></i>
                </div>
                <div class="directory-info">
                    <div class="directory-title">Cài đặt công ty</div>
                    <div class="directory-desc">Cập nhật thông tin doanh nghiệp, ngành nghề kinh doanh và loại hình hoạt động</div>
                </div>
            </div>
            <div class="directory-right">
                <span class="directory-meta text-muted">
                    @(company?.BusinessType ?? "Hồ sơ DN")
                </span>
                <span class="directory-arrow"><i class="fa-solid fa-chevron-right"></i></span>
            </div>
        </a>

        <!-- 2. Quản lý Modules -->
        <a href="@Url.Action("Modules", "Settings")" class="directory-item">
            <div class="directory-left">
                <div class="directory-icon" style="background: linear-gradient(135deg, #AF52DE, #5856D6);">
                    <i class="fa-solid fa-puzzle-piece"></i>
                </div>
                <div class="directory-info">
                    <div class="directory-title">Quản lý Modules</div>
                    <div class="directory-desc">Bật hoặc tắt các phân hệ để tối ưu tài nguyên và tinh chỉnh menu điều hướng</div>
                </div>
            </div>
            <div class="directory-right">
                <span class="directory-meta">
                    <span class="badge" style="background:rgba(48, 209, 88, 0.08); color:#1c9a44; border:1px solid rgba(48, 209, 88, 0.2)">
                        @enabledModulesCount active
                    </span>
                </span>
                <span class="directory-arrow"><i class="fa-solid fa-chevron-right"></i></span>
            </div>
        </a>

        <!-- 3. Tham số hệ thống -->
        <a href="@Url.Action("Parameters", "Settings")" class="directory-item">
            <div class="directory-left">
                <div class="directory-icon" style="background: linear-gradient(135deg, #FF9500, #FF5E3A);">
                    <i class="fa-solid fa-sliders"></i>
                </div>
                <div class="directory-info">
                    <div class="directory-title">Tham số hệ thống</div>
                    <div class="directory-desc">Cấu hình các biến số vận hành lõi, thông tin máy chủ và thiết lập mặc định</div>
                </div>
            </div>
            <div class="directory-right">
                <span class="directory-meta text-muted">
                    @parametersCount tham số
                </span>
                <span class="directory-arrow"><i class="fa-solid fa-chevron-right"></i></span>
            </div>
        </a>

        <!-- 4. Nhãn hệ thống -->
        <a href="@Url.Action("EnumLabels", "Settings")" class="directory-item">
            <div class="directory-left">
                <div class="directory-icon" style="background: linear-gradient(135deg, #30D158, #1C9A44);">
                    <i class="fa-solid fa-tags"></i>
                </div>
                <div class="directory-info">
                    <div class="directory-title">Nhãn hệ thống</div>
                    <div class="directory-desc">Tùy biến ngôn ngữ hiển thị của các trạng thái quy trình, nhãn độ ưu tiên và danh mục</div>
                </div>
            </div>
            <div class="directory-right">
                <span class="directory-meta text-muted">
                    @enumLabelsCount nhãn custom
                </span>
                <span class="directory-arrow"><i class="fa-solid fa-chevron-right"></i></span>
            </div>
        </a>

        <!-- 5. Giao diện -->
        <a href="@Url.Action("Appearance", "Settings")" class="directory-item">
            <div class="directory-left">
                <div class="directory-icon" style="background: linear-gradient(135deg, #FF2D55, #FF5E3A);">
                    <i class="fa-solid fa-palette"></i>
                </div>
                <div class="directory-info">
                    <div class="directory-title">Giao diện</div>
                    <div class="directory-desc">Thiết lập màu sắc thương hiệu, font chữ, độ bo góc, logo và tagline hiển thị</div>
                </div>
            </div>
            <div class="directory-right">
                <span class="directory-meta">
                    <span class="badge" style="background: var(--parchment); color: var(--text-secondary); border: 1px solid var(--divider); font-family: monospace;">
                        Font: @(theme?.FontFamily ?? "Inter")
                    </span>
                </span>
                <span class="directory-arrow"><i class="fa-solid fa-chevron-right"></i></span>
            </div>
        </a>
    </div>

    <!-- QUẢN TRỊ SECTION -->
    <div class="settings-section-title">
        <span class="indicator" style="background: var(--text-muted);"></span>
        <span>Quản trị & Bảo mật</span>
    </div>

    <div class="settings-directory-list shadow-sm">
        <!-- 6. Sao lưu dữ liệu -->
        <a href="@Url.Action("Index", "Backup")" class="directory-item">
            <div class="directory-left">
                <div class="directory-icon" style="background: linear-gradient(135deg, #5AC8FA, #0071E3);">
                    <i class="fa-solid fa-database"></i>
                </div>
                <div class="directory-info">
                    <div class="directory-title">Sao lưu dữ liệu</div>
                    <div class="directory-desc">Quản lý các bản sao lưu vật lý SQL Server (.bak) hoặc xuất dữ liệu portable JSON</div>
                </div>
            </div>
            <div class="directory-right">
                <span class="directory-meta text-muted">
                    @backupCount bản lưu trữ
                </span>
                <span class="directory-arrow"><i class="fa-solid fa-chevron-right"></i></span>
            </div>
        </a>

        <!-- 7. Nhật ký hoạt động -->
        <a href="@Url.Action("Index", "Audit")" class="directory-item">
            <div class="directory-left">
                <div class="directory-icon" style="background: linear-gradient(135deg, #8E8E93, #636366);">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <div class="directory-info">
                    <div class="directory-title">Nhật ký hoạt động</div>
                    <div class="directory-desc">Truy vết lịch sử thao tác của thành viên và các sự kiện ghi nhận thay đổi dữ liệu</div>
                </div>
            </div>
            <div class="directory-right">
                <span class="directory-meta text-muted">
                    @auditLogsCount logs
                </span>
                <span class="directory-arrow"><i class="fa-solid fa-chevron-right"></i></span>
            </div>
        </a>
    </div>
</div>
