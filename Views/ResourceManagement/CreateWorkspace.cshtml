@model OmniBizAI.ViewModels.WorkspaceCreateViewModel
@{
    ViewData["Title"] = "Thêm Khu Vực";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="page-title mb-1"><i class="fas fa-plus-circle me-2 text-info"></i>Thêm Khu Vực Mới</h4>
        <p class="mb-0 text-muted" style="font-size:.84rem">Thiết lập thêm một khu vực làm việc, nhà xưởng hoặc văn phòng mới.</p>
    </div>
    <a asp-action="Workspaces" class="btn btn-light"><i class="fa-solid fa-arrow-left me-1"></i>Quay lại danh sách</a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="content-card shadow-sm">
            <div class="card-body-custom p-4">
                <form asp-action="CreateWorkspace" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row g-3 mb-4">
                        <div class="col-md-8">
                            <label asp-for="Name" class="form-label fw-bold">Tên khu vực <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" placeholder="Ví dụ: Phòng A101, Xưởng Sản Xuất 1..." />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Type" class="form-label fw-bold">Loại khu vực <span class="text-danger">*</span></label>
                            <select asp-for="Type" class="form-select">
                                <option value="Building">Tòa nhà</option>
                                <option value="Floor">Tầng</option>
                                <option value="Room">Phòng</option>
                                <option value="Zone">Khu vực</option>
                                <option value="Workshop">Xưởng sản xuất</option>
                                <option value="Desk">Bàn làm việc</option>
                            </select>
                            <span asp-validation-for="Type" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Location" class="form-label fw-bold">Vị trí cụ thể / Địa chỉ</label>
                        <input asp-for="Location" class="form-control" placeholder="Ví dụ: Tầng 2, Tòa nhà A..." />
                        <span asp-validation-for="Location" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="AreaSqm" class="form-label fw-bold">Diện tích (m²)</label>
                            <input asp-for="AreaSqm" type="number" step="0.1" class="form-control" placeholder="Ví dụ: 50.5" />
                            <span asp-validation-for="AreaSqm" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Capacity" class="form-label fw-bold">Sức chứa (người)</label>
                            <input asp-for="Capacity" type="number" class="form-control" placeholder="Ví dụ: 20" />
                            <span asp-validation-for="Capacity" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ParentId" class="form-label fw-bold">Thuộc khu vực cha (nếu có)</label>
                        <select asp-for="ParentId" class="form-select">
                            <option value="">-- Không có (Khu vực gốc) --</option>
                            @foreach (var p in Model.ParentWorkspaces)
                            {
                                <option value="@p.Value">@p.Text</option>
                            }
                        </select>
                        <span asp-validation-for="ParentId" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label fw-bold">Ghi chú</label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Ghi chú thêm về khu vực làm việc này..."></textarea>
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Workspaces" class="btn btn-light px-4">Hủy</a>
                        <button type="submit" class="btn btn-info text-white px-4"><i class="fas fa-save me-1"></i>Lưu Khu Vực</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
