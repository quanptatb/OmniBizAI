@model OmniBizAI.ViewModels.EquipmentDetailViewModel
@{
    ViewData["Title"] = $"Thiết bị: {Model.Name}";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var today = DateOnly.FromDateTime(DateTime.Today);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h4 mb-0 text-gray-800"><i class="fas fa-cog text-primary me-2"></i>@Model.Name</h2>
    <div>
        <a asp-action="Equipments" class="btn btn-secondary btn-sm me-2">← Danh sách</a>
        <a asp-controller="Maintenance" asp-action="SensorMonitor" asp-route-equipmentId="@Model.Id"
           class="btn btn-outline-primary btn-sm me-2">
            <i class="fas fa-satellite-dish me-1"></i>IoT Monitor
        </a>
        <a asp-action="ScheduleMaintenance" asp-route-equipmentId="@Model.Id" class="btn btn-warning btn-sm">
            <i class="fas fa-tools me-1"></i>Lên lịch bảo trì
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        @TempData["SuccessMessage"] <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-lg-4">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 fw-bold text-primary">Thông Tin Thiết Bị</h6>
            </div>
            <div class="card-body">
                <div class="text-center mb-3">
                    <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center" style="width:80px;height:80px;">
                        <i class="fas fa-cogs fa-2x text-primary"></i>
                    </div>
                    <div class="mt-2">
                        @switch (Model.Status)
                        {
                            case "Available": <span class="badge bg-success fs-6">Sẵn sàng</span> break;
                            case "InUse": <span class="badge bg-primary fs-6">Đang dùng</span> break;
                            case "Maintenance": <span class="badge bg-warning text-dark fs-6">Đang bảo trì</span> break;
                            case "Retired": <span class="badge bg-secondary fs-6">Đã thanh lý</span> break;
                        }
                    </div>
                </div>
                <table class="table table-borderless table-sm">
                    <tr><td class="text-muted">Mã</td><td class="fw-bold">@Model.Code</td></tr>
                    <tr><td class="text-muted">Loại</td><td>@Model.Type</td></tr>
                    @if (!string.IsNullOrEmpty(Model.Location)) {
                        <tr><td class="text-muted">Vị trí</td><td>@Model.Location</td></tr>
                    }
                    @if (!string.IsNullOrEmpty(Model.Manufacturer)) {
                        <tr><td class="text-muted">NSX</td><td>@Model.Manufacturer</td></tr>
                    }
                    @if (!string.IsNullOrEmpty(Model.Model)) {
                        <tr><td class="text-muted">Model</td><td>@Model.Model</td></tr>
                    }
                    @if (!string.IsNullOrEmpty(Model.SerialNumber)) {
                        <tr><td class="text-muted">Serial</td><td><code>@Model.SerialNumber</code></td></tr>
                    }
                    @if (Model.PurchaseDate.HasValue) {
                        <tr><td class="text-muted">Ngày mua</td><td>@Model.PurchaseDate.Value.ToString("dd/MM/yyyy")</td></tr>
                    }
                    @if (Model.PurchasePrice.HasValue) {
                        <tr><td class="text-muted">Giá mua</td><td>@Model.PurchasePrice.Value.ToString("N0") VNĐ</td></tr>
                    }
                    @if (Model.LifespanYears.HasValue) {
                        <tr><td class="text-muted">Tuổi thọ</td><td>@Model.LifespanYears năm</td></tr>
                    }
                    @if (Model.NextMaintenanceDate.HasValue) {
                        var overdue = Model.NextMaintenanceDate.Value < today;
                        <tr>
                            <td class="text-muted">Bảo trì tiếp</td>
                            <td class="@(overdue ? "text-danger fw-bold" : "")">
                                @if (overdue) { <i class="fas fa-exclamation-triangle"></i> }
                                @Model.NextMaintenanceDate.Value.ToString("dd/MM/yyyy")
                            </td>
                        </tr>
                    }
                </table>
                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="border rounded p-2 bg-light small text-muted fst-italic">@Model.Notes</div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card shadow mb-4">
            <div class="card-header py-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
                <h6 class="m-0 fw-bold text-primary"><i class="fas fa-coins me-2"></i>Cost & Performance</h6>
                @if (Model.CostPerformance.ShouldRecommendReplace)
                {
                    <span class="badge bg-danger">Đề xuất Replace</span>
                }
            </div>
            <div class="card-body">
                @if (Model.CostPerformance.ShouldRecommendReplace)
                {
                    <div class="alert alert-danger py-2 small">
                        Chi phí tích lũy đã đạt @(Model.CostPerformance.CostToPurchasePercent?.ToString("0.#") ?? "N/A")% giá mua, nên xem xét thay thế thiết bị.
                    </div>
                }
                <div class="row g-3 mb-3">
                    <div class="col-md-3">
                        <div class="border rounded p-3 h-100">
                            <div class="text-muted small fw-bold text-uppercase">Tổng chi phí</div>
                            <div class="h5 mb-0">@Model.CostPerformance.TotalCost.ToString("N0") ₫</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="border rounded p-3 h-100">
                            <div class="text-muted small fw-bold text-uppercase">Downtime</div>
                            <div class="h5 mb-0">@Model.CostPerformance.DowntimeHours.ToString("0.#")h</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="border rounded p-3 h-100">
                            <div class="text-muted small fw-bold text-uppercase">MTBF</div>
                            <div class="h5 mb-0">@(Model.CostPerformance.MtbfHours?.ToString("0.#") ?? "N/A")h</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="border rounded p-3 h-100">
                            <div class="text-muted small fw-bold text-uppercase">MTTR</div>
                            <div class="h5 mb-0">@(Model.CostPerformance.MttrHours?.ToString("0.#") ?? "N/A")h</div>
                        </div>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-lg-6">
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr><th>Loại chi phí</th><th class="text-end">Số tiền</th></tr>
                                </thead>
                                <tbody>
                                    <tr><td>Mua mới</td><td class="text-end">@Model.CostPerformance.PurchaseCost.ToString("N0") ₫</td></tr>
                                    <tr><td>Bảo trì</td><td class="text-end">@Model.CostPerformance.MaintenanceCost.ToString("N0") ₫</td></tr>
                                    <tr><td>Sửa chữa</td><td class="text-end">@Model.CostPerformance.RepairCost.ToString("N0") ₫</td></tr>
                                    <tr><td>Phụ tùng</td><td class="text-end">@Model.CostPerformance.SparePartCost.ToString("N0") ₫</td></tr>
                                    <tr><td>Khác</td><td class="text-end">@Model.CostPerformance.OtherCost.ToString("N0") ₫</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr><th>Ledger gần đây</th><th class="text-end">Chi phí</th></tr>
                                </thead>
                                <tbody>
                                    @if (!Model.CostLedgers.Any())
                                    {
                                        <tr><td colspan="2" class="text-muted text-center py-3">Chưa có cost ledger.</td></tr>
                                    }
                                    @foreach (var ledger in Model.CostLedgers.Take(5))
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-bold small">@ledger.CostType</div>
                                                <div class="text-muted" style="font-size:.72rem">@ledger.OccurredDate.ToString("dd/MM/yyyy") · @ledger.Notes</div>
                                            </td>
                                            <td class="text-end">@ledger.Amount.ToString("N0") ₫</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                @if (Model.StatusHistories.Any())
                {
                    <div class="mt-3 pt-3 border-top">
                        <div class="fw-bold small text-muted text-uppercase mb-2">Status history</div>
                        <div class="d-flex gap-2 flex-wrap">
                            @foreach (var history in Model.StatusHistories.Take(6))
                            {
                                <span class="badge bg-light text-dark border" title="@history.Reason">
                                    @(history.OldStatus ?? "New") → @history.NewStatus · @history.ChangedAt.ToLocalTime().ToString("dd/MM HH:mm")
                                </span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="card shadow mb-4">
            <div class="card-header py-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
                <h6 class="m-0 fw-bold text-primary"><i class="fas fa-gauge-high me-2"></i>OEE Equipment</h6>
                <span class="badge bg-light text-dark border">@Model.RecentOeeTasks.Count task gần đây</span>
            </div>
            <div class="card-body">
                <div class="row g-3 mb-4">
                    @foreach (var item in new[] { Model.Oee7Days, Model.Oee30Days, Model.Oee90Days })
                    {
                        var color = item.OeePercent >= 85 ? "success" : item.OeePercent >= 60 ? "warning" : item.OeePercent.HasValue ? "danger" : "secondary";
                        <div class="col-md-4">
                            <div class="border rounded p-3 h-100">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div class="text-muted small fw-bold text-uppercase">@item.Days ngày</div>
                                    <span class="badge bg-@color">@item.OeeLabel</span>
                                </div>
                                <div class="small text-muted">@item.TaskCount task · Good @item.UnitsGood.ToString("0.##") / @item.UnitsProduced.ToString("0.##")</div>
                                <div class="progress mt-2" style="height:8px">
                                    <div class="progress-bar bg-@color" style="width:@(item.OeePercent ?? 0)%"></div>
                                </div>
                                <div class="d-flex gap-2 flex-wrap mt-2 small text-muted">
                                    <span>A @(item.AvailabilityPercent?.ToString("0.#") ?? "N/A")%</span>
                                    <span>P @(item.PerformancePercent?.ToString("0.#") ?? "N/A")%</span>
                                    <span>Q @(item.QualityPercent?.ToString("0.#") ?? "N/A")%</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div style="height:220px">
                    <canvas id="equipmentOeeChart"></canvas>
                </div>

                @if (Model.RecentOeeTasks.Any())
                {
                    <div class="table-responsive mt-4">
                        <table class="table table-sm align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Task</th>
                                    <th>Plan</th>
                                    <th>Actual</th>
                                    <th>Sản lượng</th>
                                    <th class="text-end">OEE</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var task in Model.RecentOeeTasks)
                                {
                                    <tr>
                                        <td>@task.TaskName</td>
                                        <td><span class="badge bg-secondary">@task.PlanCode</span></td>
                                        <td class="small text-muted">
                                            @(task.ActualDurationMinutes.HasValue ? $"{task.ActualDurationMinutes}p" : "N/A")
                                            @if (task.PlannedDurationMinutes.HasValue)
                                            {
                                                <span>/ planned @task.PlannedDurationMinutes.Value p</span>
                                            }
                                        </td>
                                        <td class="small">@((task.UnitsGood ?? 0).ToString("0.##")) / @((task.UnitsProduced ?? 0).ToString("0.##"))</td>
                                        <td class="text-end fw-bold">@(task.OeePercent.HasValue ? $"{task.OeePercent.Value:0.#}%" : "N/A")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        <i class="fas fa-gauge fa-2x mb-2 d-block text-gray-300"></i>
                        Chưa có task hoàn thành có dữ liệu OEE cho thiết bị này.
                    </div>
                }
            </div>
        </div>

        <div class="card shadow">
            <div class="card-header py-3 d-flex align-items-center justify-content-between">
                <h6 class="m-0 fw-bold text-primary"><i class="fas fa-history me-2"></i>Lịch Sử Bảo Trì (@Model.MaintenanceRecords.Count)</h6>
                <a asp-action="ScheduleMaintenance" asp-route-equipmentId="@Model.Id" class="btn btn-sm btn-warning">
                    <i class="fas fa-plus me-1"></i>Lên lịch mới
                </a>
            </div>
            <div class="card-body p-0">
                @if (!Model.MaintenanceRecords.Any())
                {
                    <div class="text-center text-muted py-5">
                        <i class="fas fa-tools fa-3x mb-3 text-gray-300 d-block"></i>
                        Chưa có lịch sử bảo trì nào.
                    </div>
                }
                @foreach (var m in Model.MaintenanceRecords)
                {
                    <div class="p-3 border-bottom">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <span class="fw-bold text-dark me-2">
                                    @switch (m.MaintenanceType)
                                    {
                                        case "Preventive": @("Bảo trì định kỳ") break;
                                        case "Corrective": @("Sửa chữa") break;
                                        case "Emergency": @("Khẩn cấp") break;
                                        default: @m.MaintenanceType break;
                                    }
                                </span>
                                @switch (m.Status)
                                {
                                    case "Scheduled": <span class="badge bg-info">Đã lên lịch</span> break;
                                    case "InProgress": <span class="badge bg-primary">Đang thực hiện</span> break;
                                    case "Completed": <span class="badge bg-success">Hoàn thành</span> break;
                                    case "Cancelled": <span class="badge bg-secondary">Đã hủy</span> break;
                                }
                            </div>
                            <div class="text-end small text-muted">
                                @m.ScheduledDate.ToString("dd/MM/yyyy")
                                @if (m.CompletedDate.HasValue) { <span class="text-success ms-2">→ @m.CompletedDate.Value.ToString("dd/MM/yy")</span> }
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(m.Description)) {
                            <div class="text-muted small mt-1">@m.Description</div>
                        }
                        @if (!string.IsNullOrEmpty(m.WorkDone)) {
                            <div class="mt-1 small"><span class="text-success fw-bold">Công việc đã làm:</span> @m.WorkDone</div>
                        }
                        <div class="d-flex gap-3 mt-1 small text-muted">
                            @if (!string.IsNullOrEmpty(m.TechnicianName)) { <span><i class="fas fa-user-cog"></i> @m.TechnicianName</span> }
                            @if (m.Cost.HasValue) { <span><i class="fas fa-money-bill-wave"></i> @m.Cost.Value.ToString("N0") VNĐ</span> }
                            @if (m.NextMaintenanceDate.HasValue) { <span><i class="fas fa-calendar-plus"></i> KH tiếp: @m.NextMaintenanceDate.Value.ToString("dd/MM/yyyy")</span> }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const trend = @Json.Serialize(Model.OeeTrend.Select(x => new {
                date = x.Date.ToString("dd/MM"),
                oee = x.OeePercent,
                taskCount = x.TaskCount
            }));
            const chartTarget = document.getElementById('equipmentOeeChart');
            if (!chartTarget || !window.Chart) return;

            new Chart(chartTarget, {
                type: 'line',
                data: {
                    labels: trend.map(x => x.date),
                    datasets: [{
                        label: 'OEE %',
                        data: trend.map(x => x.oee),
                        borderColor: '#0d6efd',
                        backgroundColor: 'rgba(13,110,253,.12)',
                        fill: true,
                        tension: .32,
                        spanGaps: true,
                        pointRadius: trend.map(x => x.taskCount > 0 ? 3 : 0)
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            min: 0,
                            max: 100,
                            ticks: { callback: value => `${value}%` }
                        }
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                afterLabel: context => `Task: ${trend[context.dataIndex].taskCount}`
                            }
                        }
                    }
                }
            });
        });
    </script>
}
