@model OmniBizAI.ViewModels.WorkShiftCreateViewModel
@{
    ViewData["Title"] = "Tạo Ca Làm Việc";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="page-title mb-1"><i class="fas fa-plus-circle me-2 text-success"></i>Tạo Ca Làm Việc Mới</h4>
        <p class="mb-0 text-muted" style="font-size:.84rem">Thiết lập khung giờ và các thông số cho ca làm việc mới.</p>
    </div>
    <a asp-action="WorkShifts" class="btn btn-light"><i class="fa-solid fa-arrow-left me-1"></i>Quay lại danh sách</a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="content-card shadow-sm">
            <div class="card-body-custom p-4">
                <form asp-action="CreateShift" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-4">
                        <label asp-for="Name" class="form-label fw-bold">Tên ca làm việc <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="Ví dụ: Ca sáng, Ca chiều, Ca đêm..." />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="StartTime" class="form-label fw-bold">Giờ bắt đầu <span class="text-danger">*</span></label>
                            <input asp-for="StartTime" type="time" class="form-control" />
                            <span asp-validation-for="StartTime" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EndTime" class="form-label fw-bold">Giờ kết thúc <span class="text-danger">*</span></label>
                            <input asp-for="EndTime" type="time" class="form-control" />
                            <span asp-validation-for="EndTime" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="WorkHours" class="form-label fw-bold">Số giờ làm việc chuẩn</label>
                            <input asp-for="WorkHours" type="number" step="0.5" class="form-control" placeholder="Ví dụ: 8" />
                            <span asp-validation-for="WorkHours" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ShiftType" class="form-label fw-bold">Loại ca làm việc</label>
                            <select asp-for="ShiftType" class="form-select">
                                <option value="Regular">Ca thường</option>
                                <option value="Overtime">Tăng ca</option>
                                <option value="Night">Ca đêm</option>
                            </select>
                            <span asp-validation-for="ShiftType" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label fw-bold">Ghi chú</label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Ghi chú thêm về ca làm việc..."></textarea>
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="WorkShifts" class="btn btn-light px-4">Hủy</a>
                        <button type="submit" class="btn btn-success px-4"><i class="fas fa-save me-1"></i>Lưu Ca Làm Việc</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
